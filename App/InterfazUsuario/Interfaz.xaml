<Window x:Class="LavanderiaApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lavandería Pro - Sistema de Gestión"
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Window.Resources>
        <!-- Estilo para botones modernos -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#4834d4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para Inputs -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DCDDE1"/>
        </Style>

        <!-- Estilo para TabControl -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="16" FontWeight="SemiBold" Margin="10,5"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header / Toolbar -->
        <Border Grid.Row="0" Background="#2f3542" Padding="20,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="LAVANDERÍA PRO" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblUsuarioSesion" Text="Usuario: Admin" Foreground="#A4B0BE" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="10">
            <!-- PESTAÑA CLIENTES -->
            <TabItem Header="Clientes">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Nuevo Cliente" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2f3542"/>
                            
                            <TextBlock Text="Nombre Completo" Foreground="#747d8c" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtNombre"/>

                            <TextBlock Text="Teléfono" Foreground="#747d8c" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtTelefono"/>

                            <TextBlock Text="Dirección" Foreground="#747d8c" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtDireccion"/>

                            <Button Content="Guardar Cliente" Style="{StaticResource ModernButton}" 
                                    Background="#2ed573" Click="BtnGuardar_Click" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Directorio de Clientes" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                            <DataGrid x:Name="dgClientes" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="None" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="120"/>
                                    <DataGridTextColumn Header="Dirección" Binding="{Binding Direccion}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- PESTAÑA PEDIDOS -->
            <TabItem Header="Pedidos">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Formulario de Pedido -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Registro de Pedido" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                                
                                <TextBlock Text="Cliente" Foreground="#747d8c" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cbClientes" DisplayMemberPath="Nombre" SelectedValuePath="IdCliente" Margin="0,0,0,15" Padding="5"/>

                                <Border BorderBrush="#f1f2f6" BorderThickness="0,0,0,1" Margin="0,0,0,15"/>

                                <TextBlock Text="Añadir Servicios" FontWeight="Bold" Margin="0,0,0,10"/>
                                <ComboBox x:Name="cbServicios" DisplayMemberPath="Nombre" Margin="0,0,0,10" Padding="5"/>
                                <DockPanel Margin="0,0,0,15">
                                    <TextBlock Text="Cant:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox x:Name="txtCantidadServicio" Width="50" Text="1" Margin="0" HorizontalContentAlignment="Center"/>
                                    <Button Content="+ Añadir" Click="BtnAddServicio_Click" 
                                            Background="#535c68" Foreground="White" Padding="15,5" Margin="10,0,0,0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </DockPanel>

                                <DataGrid x:Name="dgCarrito" Height="120" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,15">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Servicio" Binding="{Binding NombreServicio}" Width="*"/>
                                        <DataGridTextColumn Header="Cant" Binding="{Binding Cantidad}" Width="40"/>
                                        <DataGridTextColumn Header="Subt" Binding="{Binding Subtotal}" Width="60"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <DockPanel Margin="0,0,0,20">
                                    <TextBlock Text="TOTAL:" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtTotalPedido" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="#eb4d4b" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <Button Content="REGISTRAR PEDIDO" Style="{StaticResource ModernButton}" 
                                        Background="#6ab04c" Click="BtnRegistrarPedido_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Lista de Pedidos -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Pedidos en Curso" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                                <DataGrid x:Name="dgPedidos" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding IdPedido}" Width="40"/>
                                        <DataGridTextColumn Header="Cliente ID" Binding="{Binding IdCliente}" Width="70"/>
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding FechaRecepcion, StringFormat=dd/MM HH:mm}" Width="100"/>
                                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Estado}" Value="En espera">
                                                            <Setter Property="Foreground" Value="#f0932b"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Estado}" Value="Lavando">
                                                            <Setter Property="Foreground" Value="#3498db"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Estado}" Value="Terminado">
                                                            <Setter Property="Foreground" Value="#2ecc71"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="15">
                            <UniformGrid Columns="2">
                                <Button Content="Siguiente Estado" Click="BtnCambiarEstado_Click" 
                                        Margin="0,0,5,0" Style="{StaticResource ModernButton}" Background="#4834d4"/>
                                <Button Content="Entregar y Cobrar" Click="BtnEntregar_Click" 
                                        Margin="5,0,0,0" Style="{StaticResource ModernButton}" Background="#f0932b"/>
                            </UniformGrid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>