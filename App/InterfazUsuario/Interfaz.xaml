<Window x:Class="LavanderiaApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema Lavanderia"
        Height="450"
        Width="800">

    <TabControl>
        <!-- PESTAÑA 1: CLIENTES -->
        <TabItem Header="Clientes">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="20">
                    <TextBlock Text="Nombre" FontWeight="Bold"/>
                    <TextBox x:Name="txtNombre" Margin="0,0,0,10"/>

                    <TextBlock Text="Telefono" FontWeight="Bold"/>
                    <TextBox x:Name="txtTelefono" Margin="0,0,0,10"/>

                    <TextBlock Text="Direccion" FontWeight="Bold"/>
                    <TextBox x:Name="txtDireccion" Margin="0,0,0,10"/>

                    <Button Content="Guardar Cliente"
                            Width="150"
                            Height="35"
                            Background="LightBlue"
                            Click="BtnGuardar_Click"/>
                </StackPanel>

                <DockPanel Grid.Column="1" Margin="10">
                    <TextBlock DockPanel.Dock="Top" Text="Clientes Registrados" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid x:Name="dgClientes" AutoGenerateColumns="True" IsReadOnly="True"/>
                </DockPanel>
            </Grid>
        </TabItem>

        <!-- PESTAÑA 2: PEDIDOS -->
        <TabItem Header="Pedidos">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="20">
                    <TextBlock Text="Seleccionar Cliente" FontWeight="Bold"/>
                    <ComboBox x:Name="cbClientes" DisplayMemberPath="Nombre" SelectedValuePath="IdCliente" Margin="0,0,0,10"/>

                    <!-- <TextBlock Text="Fecha Entrega" FontWeight="Bold"/>
                    <DatePicker x:Name="dpFechaEntrega" Margin="0,0,0,10"/> -->

                    <TextBlock Text="Total Pedido" FontWeight="Bold"/>
                    <TextBox x:Name="txtTotalPedido" Margin="0,0,0,10"/>

                    <Button Content="Registrar Pedido"
                            Width="150"
                            Height="35"
                            Background="LightGreen"
                            Click="BtnRegistrarPedido_Click"
                            Margin="0,0,0,10"/>

                    <Button Content="Siguiente Estado"
                            Width="150"
                            Height="35"
                            Background="LightSkyBlue"
                            Click="BtnCambiarEstado_Click"
                            Margin="0,0,0,10"/>

                    <Button Content="Entregar y Pagar"
                            Width="150"
                            Height="35"
                            Background="Orange"
                            Click="BtnEntregar_Click"/>
                </StackPanel>

                <DockPanel Grid.Column="1" Margin="10">
                    <TextBlock DockPanel.Dock="Top" Text="Historial de Pedidos" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid x:Name="dgPedidos" AutoGenerateColumns="True" IsReadOnly="True"/>
                </DockPanel>
            </Grid>
        </TabItem>
    </TabControl>

</Window>