<Window x:Class="LavanderiaApp.Inicio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:local="clr-namespace:LavanderiaApp"
        Title="Lavandería Pro - Acceso" Height="680" Width="920" 
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">
    
    <Window.Resources>
        <!-- Estilo de sombra premium para la ventana -->
        <Style x:Key="WindowShadow" TargetType="Border">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="30" Color="#00418F" Opacity="0.15" ShadowDepth="4" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border Style="{StaticResource WindowShadow}" Margin="15">
        <Border CornerRadius="24" Background="#F9F9FF" BorderBrush="White" BorderThickness="1.5" ClipToBounds="True">
            <Grid>
                <!-- Botón de arrastrar / barra de título invisible -->
                <Grid Height="40" VerticalAlignment="Top" Background="Transparent" Panel.ZIndex="10" MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
                
                <!-- Botones nativos para cerrar/minimizar en la esquina superior derecha -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0" Panel.ZIndex="20">
                    <Button Width="28" Height="28" Click="BtnMinimizar_Click" ToolTip="Minimizar" Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#E6E8F3" CornerRadius="14" x:Name="border">
                                    <TextBlock Text="—" Foreground="#727784" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#DCDDEE"/>
                                        <Setter TargetName="border" Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Width="28" Height="28" Click="BtnMaximizar_Click" ToolTip="Maximizar/Restaurar" Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#E6E8F3" CornerRadius="14" x:Name="border">
                                    <TextBlock Text="▢" Foreground="#727784" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#DCDDEE"/>
                                        <Setter TargetName="border" Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Width="28" Height="28" Click="BtnSalir_Click" ToolTip="Cerrar" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FEE2E2" CornerRadius="14" x:Name="border">
                                    <TextBlock Text="✕" Foreground="#EF4444" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#FCA5A5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Blazor WebView que renderiza la interfaz HTML/CSS de Blazor -->
                <blazor:BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
                    <blazor:BlazorWebView.RootComponents>
                        <blazor:RootComponent Selector="#app" ComponentType="{x:Type local:BlazorApp}" />
                    </blazor:BlazorWebView.RootComponents>
                </blazor:BlazorWebView>
            </Grid>
        </Border>
    </Border>
</Window>