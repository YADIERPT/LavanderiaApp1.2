    private void Cancelar()
    {
        NavManager.NavigateTo("/pedidos");
    }

    private bool EsPedidoEnEspera => string.Equals(OrderStatus, "En espera", StringComparison.OrdinalIgnoreCase) ||
                                     string.Equals(OrderStatus, "En espera de lavado", StringComparison.OrdinalIgnoreCase) ||
                                     string.Equals(OrderStatus, "En espera de entrega", StringComparison.OrdinalIgnoreCase);

    private void AbrirModalCancelarPedido()
    {
        if (!EsPedidoEnEspera)
        {
            CustomMessageBox.Show("Operación Bloqueada", $"El pedido está actualmente en '{OrderStatus}'. Los pedidos que ya comenzaron a procesarse no pueden ser cancelados.", "warning");
            return;
        }

        RazonCancelacion = "";
        MostrarModalCancelarPedido = true;
    }

    private void ConfirmarCancelacionPedido()
    {
        if (!EsPedidoEnEspera)
        {
            CustomMessageBox.Show("Operación Bloqueada", "Solo los pedidos que están EN ESPERA pueden ser cancelados.", "warning");
            MostrarModalCancelarPedido = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(RazonCancelacion))
        {
            CustomMessageBox.Show("Motivo Requerido", "Por favor ingresa la razón por la cual se cancela el pedido antes de continuar.", "warning");
            return;
        }

        try
        {
            OrderStatus = "Cancelado";
            PedidoRepo.ActualizarEstadoYMaquina(Id, "Cancelado", "");

            try
            {
                new AuditoriaRepositorio().Guardar(new LavanderiaApp.Modelos.Auditoria
                {
                    Fecha = DateTime.Now,
                    Usuario = SessionManager.UsuarioActual?.Nombre ?? "Empleado",
                    Modulo = "Pedidos",
                    Accion = "Cancelación",
                    Detalle = $"Pedido #{Id} cancelado. Motivo: {RazonCancelacion.Trim()}"
                });
                new LavanderiaApp.Repositorios.NotificacionRepositorio().Agregar(new LavanderiaApp.Modelos.Notificacion
                {
                    Titulo = $"Pedido ORD-{Id:D4} Cancelado",
                    Mensaje = $"Cancelado por '{SessionManager.UsuarioActual?.Nombre}'. Motivo: {RazonCancelacion.Trim()}",
                    Tipo = "Peligro",
                    Fecha = DateTime.Now
                });
            }
            catch { }

            MostrarModalCancelarPedido = false;
            CustomMessageBox.Show("Pedido Cancelado", $"El pedido #{Id} ha sido cancelado y retirado exitosamente.\n\nMotivo: {RazonCancelacion.Trim()}", "success", () => NavManager.NavigateTo("/pedidos"));
        }
        catch (Exception ex)
        {
            CustomMessageBox.Show("Error", $"Ocurrió un error al cancelar el pedido: {ex.Message}", "error");
        }
    }

    private void GuardarCambios()
    {
        if (RawClientId <= 0 || string.IsNullOrEmpty(ClientName))
        {
            CustomMessageBox.Show("Cliente Requerido", "Por favor, seleccione un cliente para el pedido.", "warning");
            return;
        }

        if (Weight <= 0)
        {
            CustomMessageBox.Show("Peso Requerido", "Por favor, ingrese un peso válido en kg.", "warning");
            return;
        }

        var pedido = new Pedido
        {
            IdCliente = RawClientId,
            IdUsuario = SessionManager.UsuarioActual?.IdUsuario ?? 1,
            FechaRecepcion = DateTime.Now,
            Estado = string.IsNullOrEmpty(OrderStatus) ? "En espera" : OrderStatus,
            Total = (decimal)TotalCost,
            MaquinaAsignada = AssignedMachine
        };

        if (IsEditMode && Id > 0)
        {
            pedido.IdPedido = Id;
            PedidoRepo.ActualizarEstadoYMaquina(Id, OrderStatus, AssignedMachine);
            MaquinasAutomatizacion.RegistrarCicloYValidarMantenimiento(Id, OrderStatus);
            if (OrderStatus == "En Lavado")
            {
                InventarioAutomatizacion.ProcesarConsumoInventario(Id);
            }
            if (OrderStatus == "Cancelado")
            {
                try
                {
                    new AuditoriaRepositorio().Guardar(new LavanderiaApp.Modelos.Auditoria
                    {
                        Fecha = DateTime.Now,
                        Usuario = SessionManager.UsuarioActual?.Nombre ?? "Empleado",
                        Modulo = "Pedidos",
                        Accion = "Cancelación",
                        Detalle = $"Pedido #{Id} cancelado manualmente por el personal."
                    });
                }
                catch { }
            }
            CustomMessageBox.Show("Éxito", $"Pedido #{Id} actualizado exitosamente.", "success", () => NavManager.NavigateTo("/pedidos"));
        }
        else
        {
            var detalles = new List<DetallePedido>
            {
                new DetallePedido { IdServicio = SelectedServiceId, Cantidad = Weight, PrecioUnitario = (decimal)PricePerKg, Subtotal = (decimal)TotalCost }
            };

            string res = PedidoServicio.RegistrarPedido(pedido, detalles, (decimal)Anticipo, MetodoPago);
            if (res == "Éxito")
            {
                decimal total = (decimal)TotalCost;
                decimal abono = (decimal)Anticipo;
                decimal pendiente = total - abono;
                string msg = $"¡Pedido registrado exitosamente!\n\n" +
                             $"Cliente: {ClientName}\n" +
                             $"Total del Pedido: ${total:N2} MXN\n" +
                             $"Monto Abonado: ${abono:N2} MXN ({MetodoPago})\n" +
                             $"Saldo Pendiente: ${pendiente:N2} MXN";
                CustomMessageBox.Show("Pedido Registrado", msg, "success", () => NavManager.NavigateTo("/pedidos"));
            }
            else
            {
                CustomMessageBox.Show("Información de Registro", res, "info");
            }
        }
    }
}
