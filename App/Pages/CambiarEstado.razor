@page "/pedidos/estado"
@page "/pedidos/estado/{Id:int}"
@using System.Windows
@using LavanderiaApp.Servicios
@using LavanderiaApp.Modelos
@inject NavigationManager NavManager

<div class="edit-order-page-container">
    <!-- Header -->
    <div class="edit-order-header">
        <div class="header-left">
            <h1 class="header-title">Editar datos del pedido</h1>
            <p class="header-subtitle">Pedido #@TurnoHelper.ObtenerNumeroDisplay(OrderId).ToString("D2")</p>
        </div>
        <div class="header-actions">
            <button class="btn-cancelar" @onclick="Cancelar">Cancelar</button>
            <button class="btn-guardar" @onclick="GuardarCambios">Guardar cambios</button>
        </div>
    </div>

    <!-- Menu Grid Content -->
    <div class="edit-order-grid">
        <!-- Left Column: Cambiar el estado del pedido -->
        <div class="edit-order-form-column">
            <div class="dashboard-card form-section-card" style="padding: 32px 36px;">
                <div class="section-header-custom" style="margin-bottom: 28px;">
                    <div class="section-icon-wrapper bg-blue-tint">
                        <span class="material-symbols-rounded">person</span>
                    </div>
                    <h3 class="section-title-custom">Cambiar el estado del pedido</h3>
                </div>

                <!-- 6 Colored Status Buttons Grid (2 columns x 3 rows) -->
                <div class="status-selection-grid">
                    <!-- Option 1: En Lavado -->
                    <button class="btn-status-option status-lavado @(SelectedStatus == "En Lavado" ? "active" : "")" 
                            @onclick='() => SelectStatus("En Lavado")'>
                        <span class="status-option-dot"></span>
                        <span>En Lavado</span>
                    </button>

                    <!-- Option 2: En espera de lavado -->
                    <button class="btn-status-option status-espera-lavado @(SelectedStatus == "En espera de lavado" ? "active" : "")" 
                            @onclick='() => SelectStatus("En espera de lavado")'>
                        <span class="status-option-dot"></span>
                        <span>En espera de lavado</span>
                    </button>

                    <!-- Option 3: En Secado -->
                    <button class="btn-status-option status-secado @(SelectedStatus == "En Secado" ? "active" : "")" 
                            @onclick='() => SelectStatus("En Secado")'>
                        <span class="status-option-dot"></span>
                        <span>En Secado</span>
                    </button>

                    <!-- Option 4: En espera de secado -->
                    <button class="btn-status-option status-espera-secado @(SelectedStatus == "En espera de secado" ? "active" : "")" 
                            @onclick='() => SelectStatus("En espera de secado")'>
                        <span class="status-option-dot"></span>
                        <span>En espera de secado</span>
                    </button>

                    <!-- Option 5: Listo para entregar -->
                    <button class="btn-status-option status-listo @(SelectedStatus == "Listo para entregar" ? "active" : "")" 
                            @onclick='() => SelectStatus("Listo para entregar")'>
                        <span class="status-option-dot"></span>
                        <span>Listo para entregar</span>
                    </button>

                    <!-- Option 6: En espera -->
                    <button class="btn-status-option status-espera @(SelectedStatus == "En espera" ? "active" : "")" 
                            @onclick='() => SelectStatus("En espera")'>
                        <span class="status-option-dot"></span>
                        <span>En espera</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Right Column: Current Status Card -->
        <div class="edit-order-summary-column">
            <div class="dashboard-card current-status-card">
                <span class="status-header-label">ESTADO ACTUAL DEL PEDIDO</span>
                <div class="current-status-badge-container @GetStatusClass(SelectedStatus)">
                    <span class="current-status-dot"></span>
                    <span class="current-status-text">@SelectedStatus</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Confirmación: Listo para entregar -->
@if (MostrarModalConfirmarListo)
{
    <div class="tipo-pago-backdrop" @onclick="() => MostrarModalConfirmarListo = false">
        <div class="tipo-pago-modal-card" @onclick:stopPropagation style="max-width: 500px; padding: 40px 36px;">
            <div class="payment-icon-wrapper" style="margin-bottom: 20px;">
                <div class="payment-icon-bg">
                    <span class="material-symbols-rounded payment-icon" style="color: #3B82F6;">check_circle</span>
                    <span class="online-status-dot" style="background: #3B82F6;"></span>
                </div>
            </div>

            <h2 class="tipo-pago-title" style="margin-bottom: 12px; font-size: 19px; text-transform: uppercase;">
                ¿CONFIRMAR LISTO PARA ENTREGAR?
            </h2>
            <p style="color: #64748B; font-size: 14.5px; margin-bottom: 24px; text-align: center; line-height: 1.5;">
                Una vez marcado como <strong>Listo para entregar</strong>, el pedido ya habrá terminado sus procesos de lavado y secado, y <strong>ya no podrá cambiarse a ningún estado anterior</strong>.
            </p>

            <div style="display: flex; gap: 14px; justify-content: center; width: 100%;">
                <button class="btn-cancelar" style="padding: 12px 24px;" @onclick="() => MostrarModalConfirmarListo = false">
                    Cancelar
                </button>
                <button class="btn-guardar" style="padding: 12px 28px; background: #3B82F6; color: white;" @onclick="ConfirmarListoParaEntregar">
                    Sí, marcar como Listo
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal de Justificación de Retroceso -->
@if (MostrarModalJustificacionRetroceso)
{
    <div class="tipo-pago-backdrop" @onclick="() => MostrarModalJustificacionRetroceso = false">
        <div class="tipo-pago-modal-card" @onclick:stopPropagation style="max-width: 520px; padding: 40px 36px;">
            <div class="payment-icon-wrapper" style="margin-bottom: 20px;">
                <div class="payment-icon-bg">
                    <span class="material-symbols-rounded payment-icon" style="color: #0891B2;">history</span>
                    <span class="online-status-dot" style="background: #0891B2;"></span>
                </div>
            </div>

            <h2 class="tipo-pago-title" style="margin-bottom: 12px; font-size: 19px; text-transform: uppercase;">
                JUSTIFICAR RETROCESO DE ESTADO
            </h2>
            <p style="color: #64748B; font-size: 14px; margin-bottom: 18px; text-align: center; line-height: 1.5;">
                Está cambiando el pedido del estado <strong>'@EstadoOriginal'</strong> a <strong>'@SelectedStatus'</strong>.<br />
                Por favor, explique el motivo del regreso (ej. error de ciclo, secado incompleto):
            </p>

            <div style="width: 100%; margin-bottom: 24px;">
                <textarea @bind="MotivoRetroceso" placeholder="Escriba la justificación aquí..." 
                          style="width: 100%; height: 90px; border-radius: 12px; border: 1.5px solid #CBD5E1; padding: 12px; font-size: 14px; font-family: inherit; resize: none; outline: none;"></textarea>
            </div>

            <div style="display: flex; gap: 14px; justify-content: center; width: 100%;">
                <button class="btn-cancelar" style="padding: 12px 24px;" @onclick="() => MostrarModalJustificacionRetroceso = false">
                    Cancelar
                </button>
                <button class="btn-guardar" style="padding: 12px 28px; background: #0891B2; color: white;" @onclick="ConfirmarRetrocesoEstado">
                    Registrar y Regresar
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal Alerta: Máquina Ocupada -->
@if (MostrarModalMaquinaOcupada)
{
    <div class="tipo-pago-backdrop" @onclick="AceptarYGuardarEnEspera">
        <div class="tipo-pago-modal-card" @onclick:stopPropagation style="max-width: 520px; padding: 40px 36px;">
            <div class="payment-icon-wrapper" style="margin-bottom: 20px;">
                <div class="payment-icon-bg" style="background: rgba(2, 132, 199, 0.15); color: #0284C7;">
                    <span class="material-symbols-rounded payment-icon">sync_problem</span>
                    <span class="online-status-dot" style="background: #0284C7;"></span>
                </div>
            </div>

            <h2 class="tipo-pago-title" style="margin-bottom: 12px; font-size: 19px; text-transform: uppercase;">
                MÁQUINA EN USO POR OTRO PEDIDO
            </h2>
            <p style="color: #475569; font-size: 14.5px; margin-bottom: 24px; text-align: center; line-height: 1.5;">
                No se puede cambiar el pedido al estado <strong>'@SelectedStatus'</strong> porque la lavadora asignada (<strong>@MaquinaOcupadaNombre</strong>) se encuentra actualmente en un ciclo activo por otro pedido.<br /><br />
                El pedido se mantendrá en <strong>'En espera de lavado'</strong> hasta que el ciclo anterior finalice o se libere la máquina.
            </p>

            <div style="display: flex; gap: 14px; justify-content: center; width: 100%;">
                <button class="btn-guardar" style="padding: 12px 28px; background: #0284C7; color: white;" @onclick="AceptarYGuardarEnEspera">
                    Entendido (Mantener en 'En espera de lavado')
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private int OrderId = 0;
    private string SelectedStatus = "En Lavado";
    private string EstadoOriginal = "En espera";
    private bool MostrarModalConfirmarListo = false;
    private bool MostrarModalJustificacionRetroceso = false;
    private bool MostrarModalMaquinaOcupada = false;
    private string MaquinaOcupadaNombre = "";
    private string MotivoRetroceso = "";

    private PedidoRepositorio _pedidoRepo = new();

    protected override void OnInitialized()
    {
        if (Id <= 0)
        {
            NavManager.NavigateTo("/pedidos");
            return;
        }

        OrderId = Id;
        var pedidoDb = _pedidoRepo.ObtenerPorId(OrderId);
        if (pedidoDb != null)
        {
            if (pedidoDb.Estado.Equals("Entregado", StringComparison.OrdinalIgnoreCase) ||
                pedidoDb.Estado.Equals("Listo para entregar", StringComparison.OrdinalIgnoreCase) ||
                pedidoDb.Estado.Equals("PENDIENTE PARA ENTREGA", StringComparison.OrdinalIgnoreCase))
            {
                ToastService.Show("Estado Bloqueado", $"Este pedido está en estado '{pedidoDb.Estado}' y ya no puede regresar a etapas anteriores ni modificarse.", "warning");
                NavManager.NavigateTo("/pedidos");
                return;
            }
            if (!string.IsNullOrEmpty(pedidoDb.Estado))
            {
                EstadoOriginal = pedidoDb.Estado;
                SelectedStatus = pedidoDb.Estado;
            }
        }
    }

    private int ObtenerNivelEstado(string estado)
    {
        return estado switch
        {
            "En espera" => 1,
            "En espera de lavado" => 1,
            "En Lavado" => 2,
            "En espera de secado" => 3,
            "En Secado" => 4,
            "Listo para entregar" => 5,
            "PENDIENTE PARA ENTREGA" => 5,
            "Entregado" => 6,
            _ => 1
        };
    }

    private void SelectStatus(string nuevoEstado)
    {
        if (nuevoEstado.Equals("En Lavado", StringComparison.OrdinalIgnoreCase))
        {
            var pedidoDbCheck = _pedidoRepo.ObtenerPorId(OrderId);
            if (pedidoDbCheck != null && !string.IsNullOrEmpty(pedidoDbCheck.MaquinaAsignada))
            {
                if (MaquinasAutomatizacion.EstaMaquinaOcupadaPorOtroPedido(pedidoDbCheck.MaquinaAsignada, OrderId))
                {
                    MaquinaOcupadaNombre = pedidoDbCheck.MaquinaAsignada;
                    MostrarModalMaquinaOcupada = true;
                    return;
                }
            }
        }
        SelectedStatus = nuevoEstado;
    }

    private void Cancelar()
    {
        NavManager.NavigateTo("/pedidos");
    }

    private void GuardarCambios()
    {
        if (SelectedStatus == EstadoOriginal)
        {
            NavManager.NavigateTo("/pedidos");
            return;
        }

        // 1. Si intenta poner "Listo para entregar", mostrar modal de confirmación
        if (SelectedStatus.Equals("Listo para entregar", StringComparison.OrdinalIgnoreCase) && !EstadoOriginal.Equals("Listo para entregar", StringComparison.OrdinalIgnoreCase))
        {
            // Validar que el pedido haya pasado por Secado antes de estar listo para entregar
            if (ObtenerNivelEstado(EstadoOriginal) < 4)
            {
                ToastService.Show("Acceso Restringido", "El pedido no ha completado la etapa de secado. Debe pasar por 'En Secado' antes de poder marcarse como 'Listo para entregar'.", "danger");
                return;
            }
            MostrarModalConfirmarListo = true;
            return;
        }

        // Regla: No saltar lavado (pasar de espera a secado o listo)
        int nivelOriginal = ObtenerNivelEstado(EstadoOriginal);
        int nivelNuevo = ObtenerNivelEstado(SelectedStatus);

        if (nivelOriginal <= 1 && nivelNuevo >= 3)
        {
            ToastService.Show("Error", "El pedido no puede pasar a secado o entrega sin haber pasado por 'En Lavado'.", "danger");
            return;
        }

        // Regla: Si intenta pasar a En Lavado, verificar si la máquina está ocupada por otro pedido activo
        if (nivelNuevo == 2)
        {
            if (SelectedStatus.Equals("En Lavado", StringComparison.OrdinalIgnoreCase))
            {
                var pedidoDbCheck = _pedidoRepo.ObtenerPorId(OrderId);
                if (pedidoDbCheck != null && !string.IsNullOrEmpty(pedidoDbCheck.MaquinaAsignada))
                {
                    if (MaquinasAutomatizacion.EstaMaquinaOcupadaPorOtroPedido(pedidoDbCheck.MaquinaAsignada, OrderId))
                    {
                        MaquinaOcupadaNombre = pedidoDbCheck.MaquinaAsignada;
                        MostrarModalMaquinaOcupada = true;
                        return;
                    }
                }
            }
        }

        // 2. Si intenta regresar a un estado anterior en la jerarquía (Retroceso)
        if (nivelNuevo < nivelOriginal)
        {
            MotivoRetroceso = "";
            MostrarModalJustificacionRetroceso = true;
            return;
        }

        EjecutarCambioEstado();
    }

    private void ConfirmarListoParaEntregar()
    {
        MostrarModalConfirmarListo = false;
        EjecutarCambioEstado();
    }

    private void ConfirmarRetrocesoEstado()
    {
        if (string.IsNullOrWhiteSpace(MotivoRetroceso))
        {
            ToastService.Show("Motivo Requerido", "Debe ingresar una justificación para regresar a un proceso anterior.", "warning");
            return;
        }
        MostrarModalJustificacionRetroceso = false;
        EjecutarCambioEstado();
    }

    private void AceptarYGuardarEnEspera()
    {
        MostrarModalMaquinaOcupada = false;
        SelectedStatus = "En espera de lavado";
        EjecutarCambioEstado();
    }

    private void EjecutarCambioEstado()
    {
        try
        {
            var pedido = _pedidoRepo.ObtenerPorId(OrderId);
            string estadoAActualizar = SelectedStatus;
            if (SelectedStatus.Equals("Listo para entregar", StringComparison.OrdinalIgnoreCase))
            {
                if (pedido != null && pedido.FechaEntrega.HasValue && pedido.FechaEntrega.Value.Date > DateTime.Today)
                {
                    estadoAActualizar = "PENDIENTE PARA ENTREGA";
                }
            }

            _pedidoRepo.ActualizarEstado(OrderId, estadoAActualizar);
            
            if (estadoAActualizar == "En Lavado")
            {
                InventarioAutomatizacion.ProcesarConsumoInventario(OrderId);
            }

            MaquinasAutomatizacion.RegistrarCicloYValidarMantenimiento(OrderId, estadoAActualizar);

            if (pedido != null && !string.IsNullOrEmpty(pedido.MaquinaAsignada))
            {
                // Al pasar a secado, listo para entregar, pendiente para entrega, cancelado o entregado, se libera la lavadora (ya que el secado es al sol)
                if (estadoAActualizar.Equals("Listo para entregar", StringComparison.OrdinalIgnoreCase) || 
                    estadoAActualizar.Equals("PENDIENTE PARA ENTREGA", StringComparison.OrdinalIgnoreCase) || 
                    estadoAActualizar.Equals("Cancelado", StringComparison.OrdinalIgnoreCase) || 
                    estadoAActualizar.Equals("Entregado", StringComparison.OrdinalIgnoreCase) ||
                    estadoAActualizar.Equals("En espera de secado", StringComparison.OrdinalIgnoreCase) ||
                    estadoAActualizar.Equals("En Secado", StringComparison.OrdinalIgnoreCase))
                {
                    MaquinasAutomatizacion.LiberarMaquina(pedido.MaquinaAsignada);
                }
                else if (estadoAActualizar.Equals("En Lavado", StringComparison.OrdinalIgnoreCase))
                {
                    MaquinasAutomatizacion.AsignarMaquina(pedido.MaquinaAsignada);
                }
            }
            MaquinasAutomatizacion.SincronizarTodasLasMaquinas();
            
            string msj = $"Estado del Pedido #{TurnoHelper.ObtenerNumeroDisplay(OrderId):D2} cambiado a '{estadoAActualizar}'";
            if (!string.IsNullOrWhiteSpace(MotivoRetroceso))
            {
                msj += $" (Justificación: {MotivoRetroceso})";
            }
            ToastService.Show("¡Hecho!", msj, "success");
            NavManager.NavigateTo("/pedidos");
        }
        catch (Exception ex)
        {
            ToastService.Show("Error", $"Error al guardar cambios: {ex.Message}", "danger");
        }
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "En Lavado" => "status-lavado-pill",
            "En espera de lavado" => "status-espera-lavado-pill",
            "En Secado" => "status-secado-pill",
            "En espera de secado" => "status-espera-secado-pill",
            "Listo para entregar" => "status-listo-pill",
            "PENDIENTE PARA ENTREGA" => "status-listo-pill",
            "En espera" => "status-espera-pill",
            _ => "status-lavado-pill"
        };
    }
}
