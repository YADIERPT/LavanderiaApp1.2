@page "/reportes"
@using System.Windows
@using LavanderiaApp.Modelos
@using LavanderiaApp.Repositorios
@using LavanderiaApp.Servicios
@inject NavigationManager NavManager

<div class="edit-order-page-container">
    <!-- Header -->
    <div class="edit-order-header">
        <div class="header-left">
            <h1 class="header-title">Reportes Ejecutivos e Indicadores Clave</h1>
            <p class="header-subtitle">Análisis de rentabilidad PyME, horas pico y margen de utilidad neto</p>
        </div>
        <div class="header-actions">
            <button class="btn-guardar" @onclick="ExportarReportePDF">
                <span class="material-symbols-rounded" style="font-size: 18px; vertical-align: middle;">picture_as_pdf</span>
                <span>Exportar Reporte (PDF)</span>
            </button>
        </div>
    </div>

    <!-- barra de periodo de selección -->
    <div class="dashboard-card" style="padding: 16px 24px; width: 100%;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
            <div style="display: flex; gap: 10px;">
                <button class="btn-status-filter-chip @(PeriodoSeleccionado == "Diario" ? "chip-active" : "")" @onclick='() => SeleccionarPeriodo("Diario")'>
                    Diario
                </button>
                <button class="btn-status-filter-chip @(PeriodoSeleccionado == "Semanal" ? "chip-active" : "")" @onclick='() => SeleccionarPeriodo("Semanal")'>
                    Semanal
                </button>
                <button class="btn-status-filter-chip @(PeriodoSeleccionado == "Mensual" ? "chip-active" : "")" @onclick='() => SeleccionarPeriodo("Mensual")'>
                    Mensual
                </button>
            </div>

            <div style="font-size: 13.5px; color: #64748B; font-weight: 700;">
                Período: <strong style="color: #0F172A;">@FechaInicio.ToString("dd MMM yyyy") — @FechaFin.ToString("dd MMM yyyy")</strong>
            </div>
        </div>
    </div>

    <!-- 4 KPI Cards Grid -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; width: 100%;">
        <!-- KPI 1: Ingresos Totales -->
        <div class="dashboard-card" style="padding: 22px 24px; border-top: 4px solid #3B82F6;">
            <span style="font-size: 11.5px; font-weight: 800; color: #64748B; text-transform: uppercase;">Ingresos Totales</span>
            <div style="font-family: 'Outfit', sans-serif; font-size: 26px; font-weight: 800; color: #0F172A; margin: 6px 0 2px 0;">
                @ReporteActual.TotalIngresos.ToString("$#,##0.00")
            </div>
            <span style="font-size: 12px; color: #22C55E; font-weight: 700;">▲ +18.4% vs mes anterior</span>
        </div>

        <!-- KPI 2: Pedidos Procesados -->
        <div class="dashboard-card" style="padding: 22px 24px; border-top: 4px solid #10B981;">
            <span style="font-size: 11.5px; font-weight: 800; color: #64748B; text-transform: uppercase;">Pedidos Procesados</span>
            <div style="font-family: 'Outfit', sans-serif; font-size: 26px; font-weight: 800; color: #0F172A; margin: 6px 0 2px 0;">
                @ReporteActual.TotalPedidos <span style="font-size: 14px; font-weight: 600; color: #64748B;">pedidos</span>
            </div>
            <span style="font-size: 12px; color: #64748B; font-weight: 700;">@ReporteActual.PedidosCompletados completados</span>
        </div>

        <!-- KPI 3: Promedio por Pedido -->
        <div class="dashboard-card" style="padding: 22px 24px; border-top: 4px solid #8B5CF6;">
            <span style="font-size: 11.5px; font-weight: 800; color: #64748B; text-transform: uppercase;">Ticket Promedio</span>
            <div style="font-family: 'Outfit', sans-serif; font-size: 26px; font-weight: 800; color: #0F172A; margin: 6px 0 2px 0;">
                @ReporteActual.PromedioVentaPorPedido.ToString("$#,##0.00")
            </div>
            <span style="font-size: 12px; color: #64748B; font-weight: 700;">Promedio por cliente</span>
        </div>

        <!-- KPI 4: Utilidad Neta Real -->
        <div class="dashboard-card" style="padding: 22px 24px; border-top: 4px solid #F59E0B;">
            <span style="font-size: 11.5px; font-weight: 800; color: #64748B; text-transform: uppercase;">Utilidad Neta Real</span>
            <div style="font-family: 'Outfit', sans-serif; font-size: 26px; font-weight: 800; color: #059669; margin: 6px 0 2px 0;">
                @ReporteActual.UtilidadNeto.ToString("$#,##0.00")
            </div>
            <span style="font-size: 12px; color: #059669; font-weight: 700;">Menos costo de insumos (@((ReporteActual.TotalIngresos > 0 ? (100.0 - (double)(ReporteActual.TotalCostoInsumos / ReporteActual.TotalIngresos * 100)) : 100.0).ToString("0.0"))% de margen)</span>
        </div>
    </div>

    <!-- Executive Charts and Insights -->
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; width: 100%;">
        <!-- Left: Revenue Breakdown Chart -->
        <div class="dashboard-card" style="padding: 28px;">
            <h3 class="card-title-custom" style="margin-bottom: 4px;">Comparativo de Ventas y Rendimiento</h3>
            <p class="card-subtitle-custom" style="margin-bottom: 24px;">Flujo de ingresos desglosados en el período seleccionado</p>

            <!-- Chart Representation -->
            <div class="finance-chart-wrapper" style="height: 180px;">
                <svg viewBox="0 0 600 180" class="finance-svg">
                    <defs>
                        <linearGradient id="kpiGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#10B981" stop-opacity="0.25"/>
                            <stop offset="100%" stop-color="#10B981" stop-opacity="0.0"/>
                        </linearGradient>
                    </defs>
                    <path d="M 0 140 Q 100 110 200 80 T 400 50 T 600 20 L 600 160 L 0 160 Z" fill="url(#kpiGradient)" />
                    <path d="M 0 140 Q 100 110 200 80 T 400 50 T 600 20" fill="none" stroke="#10B981" stroke-width="3.5" stroke-linecap="round" />
                    <circle cx="600" cy="20" r="6" fill="#10B981" />
                </svg>
            </div>
        </div>

        <!-- Right: PyME Operational Insights -->
        <div class="dashboard-card" style="padding: 28px; display: flex; flex-direction: column; gap: 16px;">
            <h3 class="card-title-custom" style="font-size: 17px; margin-bottom: 4px;">Datos Clave PyME</h3>

            <div style="background: #F8FAFC; padding: 14px 18px; border-radius: 12px; border-left: 4px solid #3B82F6;">
                <strong style="font-size: 13px; color: #0F172A; display: block;">Hora Pico de Atención</strong>
                <span style="font-size: 12.5px; color: #64748B;">10:00 AM — 01:00 PM (45% de clientes)</span>
            </div>

            <div style="background: #F8FAFC; padding: 14px 18px; border-radius: 12px; border-left: 4px solid #10B981;">
                <strong style="font-size: 13px; color: #0F172A; display: block;">Servicio Más Rentable</strong>
                <span style="font-size: 12.5px; color: #64748B;">Lavado por Kg (68% de ingresos)</span>
            </div>

            <div style="background: #F8FAFC; padding: 14px 18px; border-radius: 12px; border-left: 4px solid #F59E0B;">
                <strong style="font-size: 13px; color: #0F172A; display: block;">Mayor Insumo Consumido</strong>
                <span style="font-size: 12.5px; color: #64748B;">Detergente Industrial (12.5L / semana)</span>
            </div>
        </div>
    </div>
</div>

@code {
    private string PeriodoSeleccionado = "Mensual";
    private DateTime FechaInicio = DateTime.Today.AddDays(-30);
    private DateTime FechaFin = DateTime.Now;

    private Reporte ReporteActual = new();
    private PedidoRepositorio _pedidoRepo = new();
    private PagoRepositorio _pagoRepo = new();

    protected override void OnInitialized()
    {
        CargarReporte();
    }

    private void SeleccionarPeriodo(string periodo)
    {
        PeriodoSeleccionado = periodo;
        if (periodo == "Diario")
        {
            FechaInicio = DateTime.Today;
        }
        else if (periodo == "Semanal")
        {
            FechaInicio = DateTime.Today.AddDays(-7);
        }
        else
        {
            FechaInicio = DateTime.Today.AddDays(-30);
        }
        CargarReporte();
    }

    private void CargarReporte()
    {
        var pedidos = _pedidoRepo.ObtenerTodos();
        var pagos = _pagoRepo.ObtenerTodos();
        ReporteActual = new Reporte(PeriodoSeleccionado, FechaInicio, FechaFin, SessionManager.UsuarioActual?.Nombre ?? "Administrador");
        ReporteActual.CalcularMetricas(pedidos, pagos);
    }

    private void ExportarReportePDF()
    {
        string resumen = ReporteActual.GenerarResumenTexto();
        CustomMessageBox.Show("Reporte PDF Generado", $"Exportando Reporte Ejecutivo PyME a PDF...\n\n{resumen}", "success");
    }
}
