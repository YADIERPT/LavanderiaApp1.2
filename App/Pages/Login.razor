@page "/"
@using System.Windows
@inject LoginServicio LoginServicio
@inject NavigationManager NavManager

<div class="login-page-wrapper">
    <div class="login-card">
        <!-- Logo wrapper -->
        <div class="logo-wrapper">
            <div class="logo-bg-1"></div>
            <div class="logo-bg-2"></div>
            <div class="logo-main">
                <span class="material-symbols-rounded">local_laundry_service</span>
            </div>
        </div>

        <!-- Title and Subtitle -->
        <div class="business-title">Lavanderias Villas del Sur</div>
        <h2 class="login-title">Iniciar Sesión</h2>
        <p class="login-subtitle">Accede a tu panel de control de la lavanderia</p>

        <!-- Error Message -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="background-color: rgba(235, 77, 75, 0.1); border-left: 4px solid #eb4d4b; color: #eb4d4b; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; display: flex; align-items: center; gap: 8px; animation: slideIn 0.3s ease;">
                <span class="material-symbols-rounded" style="font-size: 20px;">error</span>
                <span>@errorMessage</span>
            </div>
        }

        <!-- Login Form -->
        <form @onsubmit="HandleLogin">
            <div class="input-group">
                <label class="input-label" for="username">Usuario</label>
                <div class="input-container">
                    <span class="material-symbols-rounded input-icon-left">person</span>
                    <input id="username" 
                           type="text" 
                           class="form-input" 
                           placeholder="Nombre de usuario" 
                           @bind="username" 
                           required />
                </div>
            </div>

            <div class="input-group" style="margin-bottom: 30px;">
                <label class="input-label" for="password">Contraseña</label>
                <div class="input-container">
                    <span class="material-symbols-rounded input-icon-left">lock</span>
                    <input id="password" 
                           type="@passwordInputType" 
                           class="form-input" 
                           placeholder="••••••••" 
                           @bind="password" 
                           required />
                    <span class="material-symbols-rounded input-icon-right" @onclick="TogglePasswordVisibility">
                        @passwordIcon
                    </span>
                </div>
            </div>

            <button type="submit" class="btn-submit" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <div class="spinner" style="width: 20px; height: 20px; border-width: 2.5px; border-color: rgba(255,255,255,0.2); border-top-color: white; margin: 0;"></div>
                    <span>Ingresando...</span>
                }
                else
                {
                    <span>Ingresar</span>
                    <span class="material-symbols-rounded">arrow_forward</span>
                }
            </button>
        </form>

        <div class="divider"></div>
        <div class="footer-text"></div>
        <div class="footer-text" style="margin-top: 4px; font-size: 11px; opacity: 0.7;"></div>
    </div>
</div>

@if (showWelcomeModal)
{
    <!-- Recreación exacta de 'ventana login 5 pop up solo debe de aparecer al terminar login sin pasar mas de 5 seg o menos.png' -->
    <div class="tipo-pago-backdrop">
        <div class="tipo-pago-modal-card" style="max-width: 580px; padding: 56px 48px;">
            <div class="payment-icon-wrapper" style="margin-bottom: 24px;">
                <div class="payment-icon-bg" style="width: 80px; height: 80px; border-radius: 22px;">
                    <span class="material-symbols-rounded payment-icon" style="font-size: 42px;">local_laundry_service</span>
                    <span class="online-status-dot" style="width: 16px; height: 16px;"></span>
                </div>
            </div>

            <h2 class="tipo-pago-title" style="margin-bottom: 8px; font-size: 26px; font-weight: 800;">
                Lavandería villas del sur
            </h2>

            <p style="color: #475569; font-size: 16px; font-weight: 600; margin-bottom: 32px;">
                Iniciando Sesión
            </p>

            <div style="width: 100%; display: flex; justify-content: center;">
                <button class="btn-pago-efectivo" style="max-width: 260px; padding: 14px 32px; pointer-events: none;">
                    BIENVENIDO
                </button>
            </div>
        </div>
    </div>
}

<style>
@@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
</style>

@code {
    protected override void OnInitialized()
    {
        if (SessionManager.IsLoggedIn)
        {
            NavManager.NavigateTo("/dashboard");
        }
    }

    private string username = "";
    private string password = "";
    private string errorMessage = "";
    private bool isSubmitting = false;
    private bool showWelcomeModal = false;
    
    private bool showPassword = false;
    private string passwordInputType => showPassword ? "text" : "password";
    private string passwordIcon => showPassword ? "visibility_off" : "visibility";

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task HandleLogin()
    {
        errorMessage = "";
        isSubmitting = true;
        
        await Task.Delay(300);

        try
        {
            bool success = LoginServicio.Login(username, password);
            if (success)
            {
                // Muestra la ventana modal de bienvenida durante ~1.8 segundos (< 5 segundos)
                showWelcomeModal = true;
                StateHasChanged();

                await Task.Delay(1800);

                // Transición a la ventana principal de WPF
                Application.Current.Dispatcher.Invoke(() =>
                {
                    MainWindow main = new MainWindow();
                    main.Show();
                    
                    var activeWindow = Application.Current.Windows.OfType<Window>().FirstOrDefault(w => w is Inicio);
                    activeWindow?.Close();
                });
            }
            else
            {
                errorMessage = "Usuario o contraseña incorrectos";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al iniciar sesión: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
