@page "/cobro"
@page "/cobro/{Id:int}"
@page "/cobro/tarjeta"
@page "/cobro/tarjeta/{Id:int}"
@using System.Windows
@using LavanderiaApp.Modelos
@using LavanderiaApp.Servicios
@inject NavigationManager NavManager

<div class="cobro-page-container">
    <!-- Left Column: Order & Client Summary Details -->
    <div class="cobro-sidebar-column">
        <div class="dashboard-card cobro-details-card">
            <!-- Cyan-Blue Gradient Header Banner -->
            <div class="cobro-header-banner">
                <div class="header-banner-text">
                    <h2>PEDIDO # @TurnoHelper.ObtenerNumeroDisplay(OrderId)</h2>
                    <span>DETALLES</span>
                </div>
                <span class="material-symbols-rounded decorative-icon">local_laundry_service</span>
            </div>

            <!-- Details Body -->
            <div class="cobro-details-body" style="padding: 28px 26px;">
                <!-- Section 1: Información del Cliente -->
                <div class="cobro-section-title" style="font-size: 14.5px; letter-spacing: 0.5px; margin-bottom: 18px;">INFORMACIÓN DEL CLIENTE</div>
                
                <div class="cobro-property-row" style="margin-bottom: 16px;">
                    <span class="prop-label-light" style="font-size: 14px;">CLIENTE</span>
                    <span class="prop-val-dark font-bold" style="font-size: 17px;">@ClientName</span>
                </div>
                <div class="cobro-property-row" style="margin-bottom: 16px;">
                    <span class="prop-label-light" style="font-size: 14px;">TELÉFONO</span>
                    <span class="prop-val-dark" style="font-size: 16.5px;">@ClientPhone</span>
                </div>
                <div class="cobro-property-row" style="margin-bottom: 16px;">
                    <span class="prop-label-light" style="font-size: 14px;">MÁQUINA ASIGNADA</span>
                    <span class="prop-val-dark font-bold" style="font-size: 16.5px;">@AssignedMachine</span>
                </div>

                <!-- Section 2: Detalles y Servicios -->
                <div class="cobro-section-title" style="margin-top: 32px; font-size: 14.5px; letter-spacing: 0.5px; margin-bottom: 18px;">DESGLOSE DEL SERVICIO</div>
                <div class="dotted-details-list">
                    <div class="dotted-row" style="margin-bottom: 16px; font-size: 16px;">
                        <span class="dotted-label">FECHA DE RECEPCIÓN</span>
                        <span class="dotted-dots"></span>
                        <span class="dotted-val font-bold">@FormattedDate</span>
                    </div>
                    <div class="dotted-row" style="margin-bottom: 16px; font-size: 16px;">
                        <span class="dotted-label">PESO DE ROPA</span>
                        <span class="dotted-dots"></span>
                        <span class="dotted-val">@Weight.ToString("0.0") kg</span>
                    </div>
                    <div class="dotted-row" style="margin-bottom: 16px; font-size: 16px;">
                        <span class="dotted-label">TARIFA POR KG</span>
                        <span class="dotted-dots"></span>
                        <span class="dotted-val">@PricePerKg.ToString("$#,##0.00") MXN</span>
                    </div>
                    <div class="dotted-row" style="margin-bottom: 16px; font-size: 16px;">
                        <span class="dotted-label">OTROS SERVICIOS</span>
                        <span class="dotted-dots"></span>
                        <span class="dotted-val">@OtherServices.ToString("$#,##0.00") MXN</span>
                    </div>
                </div>

                @if (AplicaIva)
                {
                    <div style="margin-top: 16px; padding: 12px 16px; background: #F8FAFC; border-radius: 12px; border: 1px dashed #CBD5E1;">
                        <div style="display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 4px; color: #64748B;">
                            <span>SUBTOTAL:</span>
                            <span style="font-weight: 600;">@SubtotalSinIva.ToString("$#,##0.00")</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; font-size: 14px; color: #64748B;">
                            <span>I.V.A. (@BusinessConfig.Current.Iva%):</span>
                            <span style="font-weight: 600;">@MontoIva.ToString("$#,##0.00")</span>
                        </div>
                    </div>
                }

                <!-- Total Row (Único y Grande) -->
                <div class="cobro-total-container" style="margin-top: 28px; padding-top: 24px;">
                    <span class="cobro-total-label" style="font-size: 17px;">VALOR DEL PEDIDO</span>
                    <span class="cobro-total-amount" style="font-size: 30px; font-weight: 900;">@CostoTotalPedido.ToString("$#,##0.00")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Main Area: Payment Form (Efectivo or Tarjeta) -->
    <div class="cobro-main-column">
        <div class="dashboard-card cobro-payment-card">
            <!-- Icon header with live green status dot -->
            <div class="payment-icon-wrapper">
                <div class="payment-icon-bg">
                    <span class="material-symbols-rounded payment-icon">local_laundry_service</span>
                    <span class="online-status-dot"></span>
                </div>
            </div>

            <!-- Title -->
            <h2 class="payment-title">@(EsTarjeta ? "TARJETA" : "EFECTIVO")</h2>

            <!-- Inner White Payment Form Box -->
            <div class="payment-form-box" style="padding: 28px 32px; border-radius: 20px; width: 100%;">
                <!-- Desglose Financiero Destacado -->
                <div class="desglose-box" style="padding: 20px 24px; margin-bottom: 24px; border-radius: 16px;">
                    @if (AplicaIva)
                    {
                        <div class="desglose-row" style="font-size: 15px; margin-bottom: 8px; color: #64748B;">
                            <span>SUBTOTAL (SIN IVA)</span>
                            <span class="font-bold">@SubtotalSinIva.ToString("$#,##0.00") MXN</span>
                        </div>
                        <div class="desglose-row" style="font-size: 15px; margin-bottom: 12px; color: #64748B;">
                            <span>I.V.A. (@BusinessConfig.Current.Iva%)</span>
                            <span class="font-bold">@MontoIva.ToString("$#,##0.00") MXN</span>
                        </div>
                        <div class="desglose-divider" style="margin-bottom: 12px;"></div>
                    }
                    @if (MontoYaAbonado > 0)
                    {
                        <div class="desglose-row" style="font-size: 16px; margin-bottom: 10px;">
                            <span class="desglose-label">COSTO TOTAL DEL PEDIDO</span>
                            <span class="desglose-val font-bold">@CostoTotalPedido.ToString("$#,##0.00") MXN</span>
                        </div>
                        <div class="desglose-row desglose-abono" style="font-size: 16px; margin-bottom: 12px;">
                            <span class="desglose-abono-label" style="font-size: 15px;">
                                <span class="material-symbols-rounded" style="font-size: 20px;">check_circle</span>
                                ABONADO ANTES (ANTICIPO)
                            </span>
                            <span class="desglose-abono-val" style="font-size: 18px;">@MontoYaAbonado.ToString("$#,##0.00") MXN</span>
                        </div>
                        <div class="desglose-divider"></div>
                        <div class="desglose-row" style="margin-top: 12px;">
                            <span class="desglose-saldo-label" style="font-size: 17px; font-weight: 800;">SALDO A COBRAR</span>
                            <span class="desglose-saldo-val" style="font-size: 28px; font-weight: 900;">@SaldoDeudor.ToString("$#,##0.00") MXN</span>
                        </div>
                    }
                    else
                    {
                        <div class="desglose-row" style="display: flex; justify-content: space-between; align-items: center;">
                            <span class="desglose-saldo-label" style="font-size: 18px; font-weight: 800;">TOTAL A LIQUIDAR</span>
                            <span class="desglose-saldo-val" style="font-size: 28px; font-weight: 900; color: #0058BC;">@SaldoDeudor.ToString("$#,##0.00") MXN</span>
                        </div>
                    }
                </div>

                @if (EsTarjeta)
                {
                    <div class="payment-grid-2x2" style="margin-bottom: 24px; gap: 16px;">
                        <!-- Folio -->
                        <div class="payment-field-group">
                            <label class="payment-field-label" style="font-size: 15px; font-weight: 700; margin-bottom: 8px;">Folio de Comprobante</label>
                            <div class="payment-input-display folio-display" style="font-size: 18px; padding: 14px 18px; border-radius: 14px; font-weight: 700;">
                                @FolioText
                            </div>
                        </div>

                        <!-- Fecha de Procesamiento -->
                        <div class="payment-field-group">
                            <label class="payment-field-label" style="font-size: 15px; font-weight: 700; margin-bottom: 8px;">Día y Hora de Procesamiento</label>
                            <div class="payment-input-display" style="font-size: 16px; padding: 14px 18px; border-radius: 14px;">
                                @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="payment-grid-2x2" style="margin-bottom: 24px; gap: 16px;">
                        <!-- Recibido (Paga con) -->
                        <div class="payment-field-group">
                            <label class="payment-field-label" style="font-size: 15px; font-weight: 700; margin-bottom: 8px;">Recibido del Cliente ($)</label>
                            <div class="payment-input-wrapper">
                                <input type="number" step="1" class="payment-input-edit font-bold" 
                                       style="font-size: 22px; padding: 14px 18px; height: 52px; border-radius: 14px;"
                                       @bind="AmountPaid" @bind:event="oninput" 
                                       placeholder="0.00" />
                            </div>
                        </div>

                        <!-- Cambio a devolver -->
                        <div class="payment-field-group">
                            <label class="payment-field-label" style="font-size: 15px; font-weight: 700; margin-bottom: 8px;">Cambio a devolver ($)</label>
                            <div class="payment-input-display cambio-display font-bold" style="font-size: 22px; padding: 14px 18px; height: 52px; border-radius: 14px; color: #10B981;">
                                @CalculatedChange.ToString("$#,##0.00") MXN
                            </div>
                        </div>

                        <!-- Folio -->
                        <div class="payment-field-group">
                            <label class="payment-field-label" style="font-size: 15px; font-weight: 700; margin-bottom: 8px;">Folio de Comprobante</label>
                            <div class="payment-input-display folio-display" style="font-size: 18px; padding: 14px 18px; height: 52px; border-radius: 14px; font-weight: 700;">
                                @FolioText
                            </div>
                        </div>

                        <!-- Fecha de Procesamiento Automático -->
                        <div class="payment-field-group">
                            <label class="payment-field-label" style="font-size: 15px; font-weight: 700; margin-bottom: 8px;">Procesamiento Automático</label>
                            <div class="payment-input-display" style="font-size: 16px; padding: 14px 18px; height: 52px; border-radius: 14px; font-weight: 600;">
                                @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")
                            </div>
                        </div>
                    </div>
                }

                <!-- Bottom Action Buttons -->
                <div class="payment-actions-row" style="margin-top: 20px; gap: 16px;">
                    <button class="btn-payment-submit" style="padding: 16px 28px; font-size: 16px; font-weight: 800; border-radius: 14px;" @onclick="ProcesarPago">
                        REGISTRAR COBRO Y FINALIZAR
                    </button>
                    <button class="btn-payment-cancel" style="padding: 16px 28px; font-size: 15px; font-weight: 700; border-radius: 14px;" @onclick="Cancelar">
                        CANCELAR
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@if (MostrarModalExitoPago)
{
    <!-- Recreación exacta de 'confirmacion de pago.png' + opciones PyME (Ticket & WhatsApp) -->
    <div class="tipo-pago-backdrop">
        <div class="tipo-pago-modal-card" style="max-width: 540px; padding: 44px 40px;">
            <div class="payment-icon-wrapper" style="margin-bottom: 20px;">
                <div class="payment-icon-bg">
                    <span class="material-symbols-rounded payment-icon">local_laundry_service</span>
                    <span class="online-status-dot"></span>
                </div>
            </div>

            <h2 class="tipo-pago-title" style="margin-bottom: 24px;">
                Su pago se realizo con exito!
            </h2>

            <div style="display: flex; flex-direction: column; gap: 12px; width: 100%; margin-bottom: 24px;">
                <button class="btn-status-option status-lavado" style="justify-content: center; background: #0056C6;" @onclick="VerTicketImpresion">
                    <span class="material-symbols-rounded">receipt_long</span>
                    <span>Ver / Imprimir Ticket POS</span>
                </button>

                <button class="btn-status-option status-listo" style="justify-content: center; background: #25D366; color: white;" @onclick="EnviarTicketWhatsApp">
                    <span class="material-symbols-rounded">chat</span>
                    <span>Enviar Ticket por WhatsApp</span>
                </button>
            </div>

            <div style="width: 100%; display: flex; justify-content: center;">
                <button class="btn-payment-cancel" style="max-width: 240px; padding: 14px 28px;" @onclick="FinalizarTransaccion">
                    CONTINUAR
                </button>
            </div>
        </div>
    </div>
}

@if (MostrarModalTicketView)
{
    <div class="tipo-pago-backdrop" @onclick="() => MostrarModalTicketView = false">
        <div class="tipo-pago-modal-card" @onclick:stopPropagation style="max-width: 480px; padding: 32px; background: #FFFDF7; font-family: monospace;">
            <h3 style="text-align: center; margin-bottom: 12px; font-family: 'Outfit', sans-serif;">COMPROBANTE TÉRMICO POS</h3>
            <pre style="background: #FFFFFF; border: 1px dashed #CBD5E1; padding: 16px; border-radius: 8px; font-size: 12px; line-height: 1.4; color: #0F172A; white-space: pre-wrap; word-break: break-all;">@TextoTicketFormatted</pre>
            
            <div style="display: flex; gap: 12px; width: 100%; margin-top: 16px;">
                <button class="btn-payment-submit" @onclick="ImprimirTicket">
                    IMPRIMIR
                </button>
                <button class="btn-payment-cancel" @onclick="() => MostrarModalTicketView = false">
                    CERRAR
                </button>
            </div>
        </div>
    </div>
}

@if (MostrarModalAdvertenciaEntregaAnticipada)
{
    <div class="tipo-pago-backdrop" @onclick="() => MostrarModalAdvertenciaEntregaAnticipada = false">
        <div class="tipo-pago-modal-card" @onclick:stopPropagation style="max-width: 440px; padding: 32px; background: #FFFFFF;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px; color: #6D28D9;">
                <span class="material-symbols-rounded" style="font-size: 32px;">event_available</span>
                <h3 style="margin: 0; font-family: 'Outfit', sans-serif; font-size: 18px; font-weight: 800; color: #1E293B;">ENTREGA ANTICIPADA</h3>
            </div>
            <p style="font-size: 14px; color: #475569; line-height: 1.5; margin-bottom: 24px;">
                Este pedido fue programado para entregarse en una fecha posterior (<strong>@FechaProgramadaEntregaStr</strong>). ¿El cliente vino a recogerlo antes y deseas procesar el cobro y entrega ahora?
            </p>
            <div style="display: flex; gap: 12px; width: 100%;">
                <button class="btn-payment-submit" style="background: #6D28D9; border-color: #6D28D9;" @onclick="ConfirmarEntregaAnticipada">
                    SÍ, ENTREGAR AHORA
                </button>
                <button class="btn-payment-cancel" @onclick="() => MostrarModalAdvertenciaEntregaAnticipada = false">
                    CANCELAR
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private bool EsTarjeta => NavManager.Uri.Contains("/tarjeta");
    private bool MostrarModalExitoPago = false;
    private bool MostrarModalAdvertenciaEntregaAnticipada = false;
    private bool _advirtioEntregaAnticipada = false;
    private string FechaProgramadaEntregaStr = "";

    private int OrderId = 2;
    private string ClientName = "Julio vera";
    private string ClientPhone = "9888346747";
    private string ClientId = "01";
    private string AssignedMachine = "#2";
    private string FormattedDate = DateTime.Now.ToString("dd MMM yyyy, hh:mm tt");

    private double Weight = 12.5;
    private decimal PricePerKg = 16.00m;
    private decimal OtherServices = 0.00m;

    private decimal CostoTotalPedido = 0m;
    private decimal TotalAmount => CostoTotalPedido > 0 ? CostoTotalPedido : ((decimal)Weight * PricePerKg + OtherServices);
    private bool AplicaIva => BusinessConfig.Current != null && BusinessConfig.Current.IvaActivo && BusinessConfig.Current.Iva > 0 && CostoTotalPedido > 0;
    private decimal SubtotalSinIva => AplicaIva ? Math.Round(CostoTotalPedido / (1m + (decimal)(BusinessConfig.Current.Iva / 100.0)), 2) : CostoTotalPedido;
    private decimal MontoIva => Math.Max(0m, CostoTotalPedido - SubtotalSinIva);

    private decimal AmountPaid = 200.00m;
    private decimal MontoYaAbonado = 0m;
    private decimal SaldoDeudor = 0m;
    private decimal CalculatedChange => AmountPaid > SaldoDeudor ? AmountPaid - SaldoDeudor : 0.00m;
    private string FolioText => $"FOL-{DateTime.Now.Year}-{TurnoHelper.ObtenerNumeroDisplay(OrderId):D4}";

    private PagoServicio _pagoServicio = new();
    private PedidoRepositorio _pedidoRepo = new();
    private ClienteRepositorio _clienteRepo = new();
    private PagoRepositorio _pagoRepo = new();

    protected override void OnInitialized()
    {
        decimal activePrice = 15.00m;
        try
        {
            var servicioLavado = new ServicioRepositorio().ObtenerTodos().FirstOrDefault(s => s.IdServicio == 1);
            if (servicioLavado != null)
            {
                activePrice = servicioLavado.Precio;
            }
        }
        catch { }
        
        PricePerKg = activePrice;

        if (Id > 0)
        {
            OrderId = Id;
            var pedidoDb = _pedidoRepo.ObtenerPorId(OrderId);
            if (pedidoDb != null)
            {
                if (!pedidoDb.Estado.Equals("Listo para entregar", StringComparison.OrdinalIgnoreCase) &&
                    !pedidoDb.Estado.Equals("PENDIENTE PARA ENTREGA", StringComparison.OrdinalIgnoreCase))
                {
                    ToastService.Show("Acceso Restringido", $"El pedido #{TurnoHelper.ObtenerNumeroDisplay(OrderId):D2} está en estado '{pedidoDb.Estado}'. Solo se pueden finalizar y cobrar pedidos que estén 'Listo para entregar' o 'PENDIENTE PARA ENTREGA'.", "warning");
                    NavManager.NavigateTo("/pedidos");
                    return;
                }

                if (pedidoDb.FechaEntrega.HasValue && pedidoDb.FechaEntrega.Value.Date > DateTime.Today)
                {
                    FechaProgramadaEntregaStr = pedidoDb.FechaEntrega.Value.ToString("dd MMM yyyy");
                }
                else if (pedidoDb.Estado.Equals("PENDIENTE PARA ENTREGA", StringComparison.OrdinalIgnoreCase))
                {
                    FechaProgramadaEntregaStr = pedidoDb.FechaEntrega.HasValue ? pedidoDb.FechaEntrega.Value.ToString("dd MMM yyyy") : "Fecha posterior";
                }

                FormattedDate = pedidoDb.FechaRecepcion.ToString("dd MMM yyyy, hh:mm tt");
                var clienteDb = _clienteRepo.ObtenerPorId(pedidoDb.IdCliente);
                ClientName = clienteDb?.Nombre ?? $"Cliente #{pedidoDb.IdCliente}";
                ClientPhone = clienteDb?.Telefono ?? "";
                ClientId = pedidoDb.IdCliente.ToString("D2");
                
                var maquinasDb = new MaquinaRepositorio().ObtenerTodas();
                string machineName = !string.IsNullOrEmpty(pedidoDb.MaquinaAsignada) ? pedidoDb.MaquinaAsignada : "Sin Asignar";
                AssignedMachine = machineName;

                var detallesRepo = new DetallePedidoRepositorio();
                var detalles = detallesRepo.ObtenerPorPedido(OrderId);
                var lavadoDetalle = detalles.FirstOrDefault(d => d.IdServicio == 1);
                Weight = lavadoDetalle != null ? lavadoDetalle.Cantidad : detalles.Sum(d => d.Cantidad);
                PricePerKg = lavadoDetalle != null ? lavadoDetalle.PrecioUnitario : activePrice;
                OtherServices = detalles.Where(d => d.IdServicio != 1).Sum(d => d.Subtotal);

                var pagos = _pagoRepo.ObtenerTodos().Where(pg => pg.IdPedido == OrderId).ToList();
                decimal yaPagado = Math.Abs(pagos.Sum(pg => pg.MontoPago));
                MontoYaAbonado = yaPagado;
                
                decimal subtotalCalc = ((decimal)Weight * PricePerKg + OtherServices);
                CostoTotalPedido = pedidoDb.Total > 0 ? pedidoDb.Total : (BusinessConfig.Current.IvaActivo ? Math.Round(subtotalCalc * (1m + (decimal)(BusinessConfig.Current.Iva / 100.0)), 2) : subtotalCalc);
                SaldoDeudor = Math.Max(0m, CostoTotalPedido - yaPagado);
                AmountPaid = SaldoDeudor;
            }
            else
            {
                decimal subtotalCalc = (decimal)Weight * PricePerKg + OtherServices;
                CostoTotalPedido = BusinessConfig.Current.IvaActivo ? Math.Round(subtotalCalc * (1m + (decimal)(BusinessConfig.Current.Iva / 100.0)), 2) : subtotalCalc;
                SaldoDeudor = CostoTotalPedido;
                AmountPaid = CostoTotalPedido;
            }
        }
        else
        {
            decimal subtotalCalc = (decimal)Weight * PricePerKg + OtherServices;
            CostoTotalPedido = BusinessConfig.Current.IvaActivo ? Math.Round(subtotalCalc * (1m + (decimal)(BusinessConfig.Current.Iva / 100.0)), 2) : subtotalCalc;
            SaldoDeudor = CostoTotalPedido;
            AmountPaid = CostoTotalPedido;
        }
    }

    private void ProcesarPago()
    {
        if (!_advirtioEntregaAnticipada && !string.IsNullOrEmpty(FechaProgramadaEntregaStr) && (new PedidoRepositorio().ObtenerPorId(OrderId)?.FechaEntrega?.Date > DateTime.Today || new PedidoRepositorio().ObtenerPorId(OrderId)?.Estado.Equals("PENDIENTE PARA ENTREGA", StringComparison.OrdinalIgnoreCase) == true))
        {
            MostrarModalAdvertenciaEntregaAnticipada = true;
            return;
        }

        if (!EsTarjeta && AmountPaid < SaldoDeudor)
        {
            CustomMessageBox.Show("Monto insuficiente", $"El monto pagado (${AmountPaid:0.00}) es menor que el saldo pendiente (${SaldoDeudor:0.00}).", "warning");
            return;
        }

        var metodo = EsTarjeta ? Pago.MetodoPago.Tarjeta : Pago.MetodoPago.Efectivo;
        var resultado = _pagoServicio.ProcesarPago(OrderId, SaldoDeudor, metodo);
        if (resultado == "Éxito")
        {
            try
            {
                new LavanderiaApp.Repositorios.NotificacionRepositorio().Agregar(new LavanderiaApp.Modelos.Notificacion
                {
                    Titulo = $"Pago Recibido: ORD-{OrderId:D4}",
                    Mensaje = $"Cobro registrado por ${SaldoDeudor:N2} en {(EsTarjeta ? "Tarjeta/Digital" : "Efectivo")}.",
                    Tipo = "Exito",
                    Fecha = DateTime.Now
                });
            }
            catch {}
            MostrarModalExitoPago = true;
        }
        else
        {
            CustomMessageBox.Show("Error", $"Error al guardar pago: {resultado}", "error");
        }
    }

    private void ConfirmarEntregaAnticipada()
    {
        MostrarModalAdvertenciaEntregaAnticipada = false;
        _advirtioEntregaAnticipada = true;
        ProcesarPago();
    }

    private bool MostrarModalTicketView = false;
    private string TextoTicketFormatted = "";

    private void VerTicketImpresion()
    {
        var detalles = new DetallePedidoRepositorio().ObtenerPorPedido(OrderId);
        var servicios = new ServicioRepositorio().ObtenerTodos();
        var itemsList = detalles.Select(d =>
        {
            var s = servicios.FirstOrDefault(x => x.IdServicio == d.IdServicio);
            return new CarritoItem
            {
                NombreServicio = s?.Nombre ?? "Servicio",
                Cantidad = d.Cantidad,
                Subtotal = d.Subtotal
            };
        }).ToList();

        if (itemsList.Count == 0)
        {
            itemsList.Add(new CarritoItem { NombreServicio = "Servicio de Lavandería", Cantidad = Weight, Subtotal = TotalAmount });
        }

        var ticket = new Ticket
        {
            IdPedido = OrderId,
            ClienteNombre = ClientName,
            TelefonoCliente = ClientPhone,
            AtendidoPor = SessionManager.UsuarioActual?.Nombre ?? "Personal de Recepción",
            Total = TotalAmount,
            MontoPagado = AmountPaid,
            SaldoPendiente = 0m,
            Cambio = CalculatedChange,
            Codigo = Ticket.GenerarCodigo(OrderId),
            Items = itemsList
        };

        TextoTicketFormatted = ticket.GenerarTextoFormateado();
        MostrarModalTicketView = true;
    }

    private void EnviarTicketWhatsApp()
    {
        string mensaje = $"Hola {ClientName}, ¡tu pago de {TotalAmount.ToString("$0.00")} para el Pedido #{TurnoHelper.ObtenerNumeroDisplay(OrderId)} ha sido registrado con éxito en Lavanderías Villas del Sur! 🧺✨";
        string url = $"https://wa.me/{ClientPhone.Replace(" ", "").Replace("+", "")}?text={Uri.EscapeDataString(mensaje)}";
        CustomMessageBox.Show("Notificación por WhatsApp", $"Abriendo WhatsApp Web para notificar a {ClientName} ({ClientPhone})...\n\nMensaje: {mensaje}", "info");
    }

    private void ImprimirTicket()
    {
        CustomMessageBox.Show("Impresión en proceso", "Enviando comprobante a la impresora térmica POS...", "info");
        MostrarModalTicketView = false;
    }

    private void FinalizarTransaccion()
    {
        MostrarModalExitoPago = false;
        ToastService.Show("¡Pago Procesado!", $"El cobro del Pedido #{TurnoHelper.ObtenerNumeroDisplay(OrderId):D2} por {TotalAmount.ToString("$#,##0.00")} fue registrado exitosamente.", "success");
        NavManager.NavigateTo("/pedidos");
    }

    private void Cancelar()
    {
        NavManager.NavigateTo("/pedidos");
    }
}
