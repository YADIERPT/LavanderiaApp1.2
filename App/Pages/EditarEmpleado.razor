@page "/empleados/editar"
@page "/empleados/editar/{id:int}"
@page "/empleados/agregar"
@using System.Windows
@using Microsoft.AspNetCore.Components.Forms
@using LavanderiaApp.Modelos
@using LavanderiaApp.Repositorios
@using LavanderiaApp.Servicios
@inject UsuarioRepositorio UsuarioRepo
@inject NavigationManager NavManager

<div class="edit-emp-page-container">
    <!-- Breadcrumbs & Header -->
    <div class="edit-emp-breadcrumbs">
        <span class="breadcrumb-link" @onclick="GoToEmployees">Empleados</span>
        <span class="breadcrumb-separator">&gt;</span>
        <span class="breadcrumb-current">@(IsEditMode ? "editar Perfil" : "agregar Perfil")</span>
    </div>

    <div class="edit-emp-header">
        <div class="header-left">
            <h1 class="header-title">Gestión de empleados</h1>
            <p class="header-subtitle">
                Agregar datos contractuales y seguridad de acceso para @(IsEditMode ? (string.IsNullOrWhiteSpace(Nombre) ? "-------" : Nombre) : "-------")
            </p>
        </div>
        <div class="header-actions">
            <button class="btn-cancelar" @onclick="GoToEmployees">Descartar</button>
            @if (IsEditMode)
            {
                <button class="btn-cancelar" style="background: #FEE2E2; color: #DC2626; border: 1px solid #FECACA; display: flex; align-items: center; gap: 6px; font-weight: 600;" @onclick="IntentarEliminarEmpleado">
                    <span class="material-symbols-rounded" style="font-size: 18px;">delete</span>
                    <span>Eliminar Empleado</span>
                </button>
            }
            <button class="btn-guardar" @onclick="GuardarDatos">
                <span class="material-symbols-rounded" style="font-size: 18px; vertical-align: middle; margin-right: 6px;">save</span>
                <span>Guardar datos</span>
            </button>
        </div>
    </div>

    <!-- Main 2-column Grid -->
    <div class="edit-emp-grid">
        <!-- Left Column: Profile Card -->
        <div class="edit-emp-profile-column">
            <div class="dashboard-card profile-upload-card">
                <!-- Interactive Avatar Box for Photo Upload -->
                <div class="avatar-upload-box" style="position: relative; cursor: pointer; overflow: hidden; display: flex; align-items: center; justify-content: center;" title="Haga clic para subir foto del empleado">
                    <InputFile id="employeePhotoInput" OnChange="UploadEmployeePhoto" accept="image/*" 
                               style="position: absolute; opacity: 0; width: 100%; height: 100%; top: 0; left: 0; cursor: pointer; z-index: 10;" />
                    
                    @if (!string.IsNullOrEmpty(AvatarImageData))
                    {
                        <img src="@AvatarImageData" style="width: 100%; height: 100%; object-fit: cover; border-radius: 18px;" alt="Foto del empleado" />
                    }
                    else if (IsEditMode && !string.IsNullOrWhiteSpace(Nombre))
                    {
                        <div class="avatar-uploaded-circle">
                            <span class="material-symbols-rounded">support_agent</span>
                        </div>
                    }
                    else
                    {
                        <div class="avatar-upload-placeholder" style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
                            <span class="material-symbols-rounded" style="font-size: 32px;">add</span>
                        </div>
                    }
                </div>

                <span class="profile-card-name">@(IsEditMode && !string.IsNullOrWhiteSpace(Nombre) ? Nombre : "---------")</span>
                
                <div class="profile-card-badge-container">
                    <span class="profile-card-status-badge @(IsEditMode ? (Estado == "ACTIVO" ? "badge-active" : "badge-rest") : "badge-unregistered")">
                        <span class="badge-dot"></span>
                        <span>@(IsEditMode ? Estado : "SIN REGISTRO")</span>
                    </span>
                </div>

                <div class="profile-card-divider"></div>

                <div class="profile-card-meta-row">
                    <span class="meta-label">ID EMPLEADO</span>
                    <span class="meta-val">@(IsEditMode ? (string.IsNullOrWhiteSpace(Codigo) ? $"EMP-{Id:D2}" : Codigo) : "-------")</span>
                </div>
                <div class="profile-card-meta-row">
                    <span class="meta-label">ÚLTIMO ACCESO</span>
                    <span class="meta-val">@(IsEditMode ? UltimoAcceso : "---------")</span>
                </div>
            </div>
        </div>

        <!-- Right Column: Forms Column -->
        <div class="edit-emp-forms-column">
            <!-- Card 1: Credenciales de Acceso -->
            <div class="dashboard-card form-section-card">
                <div class="section-header-custom">
                    <div class="section-icon-wrapper bg-blue-tint">
                        <span class="material-symbols-rounded">lock</span>
                    </div>
                    <h3 class="section-title-custom">Credenciales de Acceso</h3>
                </div>

                <div class="form-inputs-grid-2x2">
                    <div class="form-input-group">
                        <label class="form-input-label">NOMBRE COMPLETO</label>
                        <div class="form-input-wrapper">
                            <input type="text" class="form-input-field no-icon" @bind="Nombre" placeholder="Ej. Juan Pérez" />
                        </div>
                    </div>
                    <div class="form-input-group">
                        <label class="form-input-label">NOMBRE DE USUARIO</label>
                        <div class="form-input-wrapper">
                            <input type="text" class="form-input-field no-icon" @bind="Usuario" placeholder="Inserte usuario" />
                        </div>
                    </div>
                    <div class="form-input-group">
                        <label class="form-input-label">ROL DE SISTEMA</label>
                        <div class="form-input-wrapper">
                            <select class="form-input-field no-icon select-field" @bind="Rol">
                                <option value="">Elija rol</option>
                                <option value="Administrador">Administrador</option>
                                <option value="Recepcionista">Recepcionista</option>
                                <option value="Lavadero">Lavadero</option>
                                <option value="Supervisor">Supervisor</option>
                                @if (SessionManager.UsuarioActual?.EsMaster == true || Rol == "Master")
                                {
                                    <option value="Master">Master</option>
                                }
                                @if (Rol == "Admin")
                                {
                                    <option value="Admin">Admin</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-input-group">
                        <label class="form-input-label">CONTRASEÑA</label>
                        <div class="form-input-wrapper action-input">
                            <input type="password" class="form-input-field no-icon" value="@PasswordDisplay" placeholder="••••••••••" readonly />
                            <button class="btn-change-password" @onclick="AbrirModalCambiarPassword">Cambiar</button>
                        </div>
                    </div>
                    <div class="form-input-group">
                        <label class="form-input-label">NUMERO DE TELEFONO</label>
                        <div class="form-input-wrapper">
                            <input type="text" class="form-input-field no-icon" @bind="Telefono" placeholder="Inserte teléfono" />
                        </div>
                    </div>
                    <div class="form-input-group">
                        <label class="form-input-label">CORREO ELECTRÓNICO</label>
                        <div class="form-input-wrapper">
                            <input type="email" class="form-input-field no-icon" @bind="Correo" placeholder="@@gmail.com" />
                        </div>
                    </div>
                    <div class="form-input-group">
                        <label class="form-input-label">EDAD</label>
                        <div class="form-input-wrapper">
                            <input type="number" class="form-input-field no-icon" @bind="Edad" placeholder="19" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 2: Información Contractual -->
            <div class="dashboard-card form-section-card">
                <div class="section-header-custom">
                    <div class="section-icon-wrapper bg-blue-tint" style="color: #15803D; background: #E8F8F0;">
                        <span class="material-symbols-rounded">description</span>
                    </div>
                    <h3 class="section-title-custom">Información Contractual</h3>
                </div>

                <div class="form-inputs-grid-2x2">
                    <div class="form-input-group">
                        <label class="form-input-label">TIPO DE CONTRATO Y TURNO</label>
                        <div class="form-input-wrapper">
                            <select class="form-input-field no-icon select-field" @bind="Turno">
                                <option value="">Seleccione turno y contrato</option>
                                <option value="Matutino - Tiempo Completo">Matutino - Tiempo Completo</option>
                                <option value="Vespertino - Tiempo Completo">Vespertino - Tiempo Completo</option>
                                <option value="Matutino - Medio Tiempo">Matutino - Medio Tiempo</option>
                                <option value="Vespertino - Medio Tiempo">Vespertino - Medio Tiempo</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-input-group">
                        <label class="form-input-label">FECHA DE INCORPORACIÓN</label>
                        <div class="form-input-wrapper">
                            <input type="text" class="form-input-field no-icon" @bind="FechaContrato" placeholder="dd/mm/yyyy" readonly="@(!IsEditMode)" />
                        </div>
                    </div>
                    <div class="form-input-group">
                        <label class="form-input-label">SALARIO BASE (ANUAL BRUTO)</label>
                        <div class="form-input-wrapper">
                            <span class="currency-indicator">$</span>
                            <input type="text" class="form-input-field currency-input" @bind="SalarioAnual" placeholder="0.00" />
                        </div>
                    </div>
                    <div class="form-input-group">
                        <label class="form-input-label">SUCURSAL ASIGNADA</label>
                        <div class="form-input-wrapper">
                            <select class="form-input-field no-icon select-field" @bind="Sucursal">
                                <option value="">Elija sucursal</option>
                                @if (BusinessConfig.Current.Sucursales != null)
                                {
                                    @foreach (var suc in BusinessConfig.Current.Sucursales)
                                    {
                                        <option value="@suc">@suc</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Interactivo para Cambiar Contraseña (Acceso Administrador) -->
@if (ShowChangePasswordModal)
{
    <div class="tipo-pago-backdrop" @onclick="() => ShowChangePasswordModal = false">
        <div class="tipo-pago-modal-card" @onclick:stopPropagation style="max-width: 480px; padding: 36px;">
            <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 20px;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div class="section-icon-wrapper bg-blue-tint">
                        <span class="material-symbols-rounded">lock_reset</span>
                    </div>
                    <div>
                        <h3 class="section-title-custom">Cambiar Contraseña</h3>
                        <span style="font-size: 12px; color: #0056C6; font-weight: 700;">Panel de Administrador</span>
                    </div>
                </div>
                <button @onclick="() => ShowChangePasswordModal = false" style="background: none; border: none; cursor: pointer;">
                    <span class="material-symbols-rounded">close</span>
                </button>
            </div>

            <!-- New Password Input -->
            <div class="form-input-group" style="width: 100%; margin-bottom: 16px;">
                <label class="form-input-label">NUEVA CONTRASEÑA</label>
                <div class="form-input-wrapper">
                    <span class="material-symbols-rounded form-input-icon">key</span>
                    <input type="@(ShowNewPasswordToggle ? "text" : "password")" class="form-input-field" @bind="NewPasswordInput" placeholder="Ingrese nueva contraseña..." />
                    <span class="material-symbols-rounded" style="cursor: pointer; color: #64748B; margin-right: 12px;" @onclick="() => ShowNewPasswordToggle = !ShowNewPasswordToggle">
                        @(ShowNewPasswordToggle ? "visibility_off" : "visibility")
                    </span>
                </div>
            </div>

            <!-- Confirm Password Input -->
            <div class="form-input-group" style="width: 100%; margin-bottom: 24px;">
                <label class="form-input-label">CONFIRMAR NUEVA CONTRASEÑA</label>
                <div class="form-input-wrapper">
                    <span class="material-symbols-rounded form-input-icon">lock</span>
                    <input type="@(ShowNewPasswordToggle ? "text" : "password")" class="form-input-field" @bind="ConfirmPasswordInput" placeholder="Repita la nueva contraseña..." />
                </div>
            </div>

            <!-- Modal Action Buttons -->
            <div style="display: flex; gap: 14px; width: 100%;">
                <button class="btn-payment-submit" style="background: #0056C6;" @onclick="GuardarNuevaContrasena">
                    GUARDAR CONTRASEÑA
                </button>
                <button class="btn-payment-cancel" @onclick="() => ShowChangePasswordModal = false">
                    CANCELAR
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal de Confirmación de Eliminación de Empleado -->
@if (MostrarModalConfirmarEliminar)
{
    <div class="tipo-pago-backdrop" @onclick="() => MostrarModalConfirmarEliminar = false">
        <div class="tipo-pago-modal-card" @onclick:stopPropagation style="max-width: 480px; padding: 36px;">
            <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 20px;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div class="section-icon-wrapper" style="background: #FEE2E2; color: #DC2626;">
                        <span class="material-symbols-rounded">warning</span>
                    </div>
                    <div>
                        <h3 class="section-title-custom" style="color: #DC2626;">Eliminar Empleado</h3>
                        <span style="font-size: 12px; color: #64748B; font-weight: 700;">Acción Irreversible</span>
                    </div>
                </div>
                <button @onclick="() => MostrarModalConfirmarEliminar = false" style="background: none; border: none; cursor: pointer;">
                    <span class="material-symbols-rounded">close</span>
                </button>
            </div>

            <p style="color: #334155; font-size: 14px; line-height: 1.6; margin-bottom: 24px;">
                ¿Estás seguro de que deseas eliminar permanentemente al empleado <strong>@Nombre</strong> (<strong>@Usuario</strong>)? 
                Esta acción retirará todos sus accesos al sistema.
            </p>

            <div style="display: flex; gap: 14px; width: 100%;">
                <button class="btn-payment-submit" style="background: #DC2626; color: white;" @onclick="ConfirmarEliminacion">
                    CONFIRMAR ELIMINACIÓN
                </button>
                <button class="btn-payment-cancel" @onclick="() => MostrarModalConfirmarEliminar = false">
                    CANCELAR
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private bool IsEditMode => Id > 0 || NavManager.Uri.Contains("/editar/");

    private string Nombre = "";
    private string Codigo = "";
    private string Estado = "ACTIVO";
    private string Usuario = "";
    private string Rol = "";
    private string Password = "";
    private string PasswordDisplay => string.IsNullOrEmpty(Password) ? "(sin contraseña)" : "••••••••";
    private string Telefono = "";
    private string Correo = "";
    private int? Edad = null;
    private string Turno = "";
    private string FechaContrato = "";
    private string SalarioAnual = "0.00";
    private string Sucursal = "";
    private string UltimoAcceso = "Sesión activa";
    private string? AvatarImageData;

    // Variables para el modal de cambio de contraseña
    private bool ShowChangePasswordModal = false;
    private string NewPasswordInput = "";
    private string ConfirmPasswordInput = "";
    private bool ShowNewPasswordToggle = false;

    private bool MostrarModalConfirmarEliminar = false;

    protected override void OnInitialized()
    {
        if (Id > 0)
        {
            var user = UsuarioRepo.ObtenerPorId(Id);
            if (user != null)
            {
                Nombre = user.Nombre;
                Usuario = user.NombreUsuario;
                Password = user.Password;
                Rol = string.IsNullOrEmpty(user.Rol) ? "Operador" : user.Rol;
                Estado = "ACTIVO";
                Codigo = $"EMP-{user.IdUsuario:D2}";
                UltimoAcceso = "Sesión registrada";
                Telefono = user.Telefono ?? "";
                Correo = user.Correo ?? "";
                Turno = user.Turno ?? "";
                FechaContrato = user.FechaContrato ?? "";
                SalarioAnual = user.Salario > 0 ? user.Salario.ToString("0.00") : "0.00";
                Sucursal = user.Sucursal ?? "";
                Edad = user.Edad > 0 ? user.Edad : null;

                if (string.IsNullOrEmpty(FechaContrato))
                {
                    FechaContrato = DateTime.Now.ToString("dd/MM/yyyy");
                }
                if (string.IsNullOrEmpty(Sucursal) && BusinessConfig.Current.Sucursales?.Count > 0)
                {
                    Sucursal = BusinessConfig.Current.Sucursales[0];
                }
            }
        }
        else
        {
            Nombre = "";
            Usuario = "";
            Rol = "";
            Codigo = "-------";
            Estado = "SIN REGISTRO";
            FechaContrato = DateTime.Now.ToString("dd/MM/yyyy");
            if (BusinessConfig.Current.Sucursales?.Count > 0)
            {
                Sucursal = BusinessConfig.Current.Sucursales[0];
            }
        }
    }

    private async Task UploadEmployeePhoto(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                var resizedFile = await file.RequestImageFileAsync("image/png", 300, 300);
                using var stream = resizedFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                byte[] buffer = ms.ToArray();
                AvatarImageData = $"data:image/png;base64,{Convert.ToBase64String(buffer)}";
                StateHasChanged();
            }
        }
        catch (System.Exception ex)
        {
            CustomMessageBox.Show("Error de Carga", $"Error al cargar la foto: {ex.Message}", "warning");
        }
    }

    private void AbrirModalCambiarPassword()
    {
        NewPasswordInput = "";
        ConfirmPasswordInput = "";
        ShowNewPasswordToggle = false;
        ShowChangePasswordModal = true;
    }

    private void GuardarNuevaContrasena()
    {
        if (string.IsNullOrWhiteSpace(NewPasswordInput))
        {
            CustomMessageBox.Show("Campo Requerido", "Por favor, ingrese la nueva contraseña.", "warning");
            return;
        }

        if (NewPasswordInput != ConfirmPasswordInput)
        {
            CustomMessageBox.Show("Contraseñas No Coinciden", "Las contraseñas ingresadas no coinciden. Por favor, verifique.", "warning");
            return;
        }

        Password = NewPasswordInput;

        if (IsEditMode && Id > 0)
        {
            var user = UsuarioRepo.ObtenerPorId(Id);
            if (user != null)
            {
                user.Password = NewPasswordInput;
                UsuarioRepo.Actualizar(user);
            }
        }

        ShowChangePasswordModal = false;
        CustomMessageBox.Show("Contraseña Actualizada", "La contraseña del empleado ha sido actualizada exitosamente con permisos de Administrador.", "success");
    }

    private void GoToEmployees()
    {
        NavManager.NavigateTo("/empleados");
    }

    private void GuardarDatos()
    {
        if (string.IsNullOrWhiteSpace(Usuario))
        {
            CustomMessageBox.Show("Campo Requerido", "Por favor, ingrese el nombre de usuario.", "warning");
            return;
        }

        string nombreGuardar = string.IsNullOrWhiteSpace(Nombre) ? Usuario : Nombre;

        decimal salarioVal = 0m;
        if (!string.IsNullOrWhiteSpace(SalarioAnual))
        {
            decimal.TryParse(SalarioAnual.Replace("$", "").Replace(",", "").Trim(), out salarioVal);
        }

        if (IsEditMode && Id > 0)
        {
            var user = new Usuario
            {
                IdUsuario = Id,
                Nombre = nombreGuardar,
                NombreUsuario = Usuario,
                Password = string.IsNullOrWhiteSpace(Password) ? "123" : Password,
                Rol = string.IsNullOrWhiteSpace(Rol) ? "Empleado" : Rol,
                Telefono = Telefono ?? "",
                Correo = Correo ?? "",
                Turno = Turno ?? "",
                FechaContrato = FechaContrato ?? "",
                Salario = salarioVal,
                Sucursal = Sucursal ?? "",
                Edad = Edad ?? 0
            };
            UsuarioRepo.Actualizar(user);
            CustomMessageBox.Show("Éxito", $"Empleado '{nombreGuardar}' guardado exitosamente.", "success", () => NavManager.NavigateTo("/empleados"));
        }
        else
        {
            var user = new Usuario
            {
                Nombre = nombreGuardar,
                NombreUsuario = Usuario,
                Password = string.IsNullOrWhiteSpace(Password) ? "123" : Password,
                Rol = string.IsNullOrWhiteSpace(Rol) ? "Empleado" : Rol,
                Telefono = Telefono ?? "",
                Correo = Correo ?? "",
                Turno = Turno ?? "",
                FechaContrato = FechaContrato ?? "",
                Salario = salarioVal,
                Sucursal = Sucursal ?? "",
                Edad = Edad ?? 0
            };
            UsuarioRepo.Guardar(user);
            CustomMessageBox.Show("Éxito", $"Empleado '{nombreGuardar}' registrado exitosamente.", "success", () => NavManager.NavigateTo("/empleados"));
        }
    }

    private void IntentarEliminarEmpleado()
    {
        if (SessionManager.UsuarioActual == null)
        {
            CustomMessageBox.Show("Sesión No Válida", "Debes iniciar sesión para realizar esta acción.", "warning");
            return;
        }

        // 1. Asegurar que el admin no se pueda eliminar a sí mismo
        if (Id == SessionManager.UsuarioActual.IdUsuario || 
            string.Equals(Usuario, SessionManager.UsuarioActual.NombreUsuario, StringComparison.OrdinalIgnoreCase))
        {
            CustomMessageBox.Show("Acción no permitida", "No puedes eliminar tu propia cuenta de usuario mientras tienes la sesión activa.", "warning");
            return;
        }

        var targetUser = UsuarioRepo.ObtenerPorId(Id);
        if (targetUser == null)
        {
            CustomMessageBox.Show("Error", "No se encontró el usuario especificado en el sistema.", "danger");
            return;
        }

        bool esObjetivoAdmin = targetUser.Rol.Equals("Admin", StringComparison.OrdinalIgnoreCase) || 
                               targetUser.Rol.Equals("Administrador", StringComparison.OrdinalIgnoreCase) ||
                               targetUser.Rol.Equals("Master", StringComparison.OrdinalIgnoreCase);

        // 2. Solo la cuenta Master puede eliminar a administradores
        if (esObjetivoAdmin && !SessionManager.UsuarioActual.EsMaster)
        {
            CustomMessageBox.Show("Permiso denegado", "Solo la cuenta Master tiene autorización para eliminar cuentas de Administrador.", "danger");
            return;
        }

        // 3. Si es empleado normal, se requiere ser Administrador o Master
        if (!esObjetivoAdmin && !SessionManager.UsuarioActual.EsAdmin && !SessionManager.UsuarioActual.EsMaster)
        {
            CustomMessageBox.Show("Permiso denegado", "No tienes permisos de Administrador para eliminar empleados.", "danger");
            return;
        }

        MostrarModalConfirmarEliminar = true;
    }

    private void ConfirmarEliminacion()
    {
        MostrarModalConfirmarEliminar = false;
        try
        {
            UsuarioRepo.Eliminar(Id);
            
            try
            {
                new NotificacionRepositorio().Agregar(new Notificacion
                {
                    Titulo = "Usuario Eliminado",
                    Mensaje = $"El usuario '{Nombre}' ({Usuario} - {Rol}) fue eliminado del sistema por '{SessionManager.UsuarioActual?.Nombre}'.",
                    Tipo = "Alerta",
                    Fecha = DateTime.Now,
                    Leida = false
                });
            }
            catch { }

            CustomMessageBox.Show("Empleado Eliminado", $"El empleado '{Nombre}' ha sido eliminado correctamente del sistema.", "success", () => NavManager.NavigateTo("/empleados"));
        }
        catch (Exception ex)
        {
            CustomMessageBox.Show("Error al eliminar", $"No se pudo eliminar el usuario: {ex.Message}", "danger");
        }
    }
}
