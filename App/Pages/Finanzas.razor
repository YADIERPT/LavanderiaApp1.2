    private string GetBadgeClass(string estado)
    {
        return estado.ToUpper() switch
        {
            "ENTREGADO" or "PAGADO" => "badge-completado",
            "LAVANDO" => "badge-lavando",
            "SECANDO" => "badge-secando",
            _ => "badge-espera"
        };
    }

    private string GetIconClass(string estado)
    {
        return estado.ToUpper() switch
        {
            "ENTREGADO" or "PAGADO" => "status-completado",
            "LAVANDO" => "status-lavando",
            "SECANDO" => "status-secando",
            _ => "status-espera"
        };
    }
