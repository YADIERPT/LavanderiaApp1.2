@page "/pedidos"
@using System.Windows
@using LavanderiaApp.Modelos
@using LavanderiaApp.Servicios
@inject NavigationManager NavManager

<div class="orders-page-container">
    <!-- Left Column: Orders List -->
    <div class="orders-list-column">
        <div class="dashboard-card orders-card">
            <!-- Header -->
            <div class="orders-list-header">
                <h1 class="header-title">Gestión de pedidos</h1>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <button class="filter-button @(OcultarCancelados ? "filter-active" : "")" @onclick="ToggleOcultarCancelados" title="@(OcultarCancelados ? "Haz clic para mostrar los pedidos cancelados" : "Haz clic para ocultar los pedidos cancelados")">
                        <span class="material-symbols-rounded">@(OcultarCancelados ? "visibility_off" : "visibility")</span>
                        <span>@(OcultarCancelados ? "Ocultando cancelados" : "Mostrar cancelados")</span>
                    </button>
                    <button class="filter-button @(SelectedStatusFilter != "TODOS" || !string.IsNullOrEmpty(SearchText) ? "filter-active" : "")" @onclick="ToggleFilters">
                        <span class="material-symbols-rounded">filter_list</span>
                        <span>Filtrar @(SelectedStatusFilter != "TODOS" ? $"({SelectedStatusFilter})" : "")</span>
                    </button>
                </div>
            </div>

            <!-- Active Filter Badge Bar if filtering -->
            @if (SelectedStatusFilter != "TODOS" || !string.IsNullOrEmpty(SearchText))
            {
                <div class="active-filter-bar">
                    <span>Filtro: <strong>@SelectedStatusFilter</strong> @(!string.IsNullOrEmpty(SearchText) ? $"• \"{SearchText}\"" : "")</span>
                    <button class="btn-clear-filter" @onclick="LimpiarFiltros">
                        <span class="material-symbols-rounded" style="font-size: 14px;">close</span>
                    </button>
                </div>
            }

            <!-- Orders vertical list -->
            <div class="orders-vertical-list">
                @if (FilteredOrders.Any())
                {
                    @foreach (var order in FilteredOrders)
                    {
                        <div class="order-row-item @(SelectedOrder?.Id == order.Id ? "selected" : "")" @onclick="() => SelectOrder(order)">
                            <div class="order-icon-container @GetIconClass(order.Estado)">
                                <span class="material-symbols-rounded">@GetIconSymbol(order.Estado)</span>
                            </div>
                            <div class="order-info-details">
                                <span class="order-title">Pedido #@order.NumeroDisplay</span>
                                <span class="order-subtitle">@order.Cliente • @order.Peso.ToString("0.0") kg</span>
                                @if (order.EsPendienteEntrega)
                                {
                                    <span style="display: inline-block; font-size: 10px; background: #EDE9FE; color: #6D28D9; border: 1px solid #DDD6FE; padding: 2px 6px; border-radius: 4px; font-weight: 700; margin-top: 4px; width: fit-content;">PENDIENTE PARA ENTREGA</span>
                                }
                            </div>
                            <div class="order-status-badge-container">
                                <span class="order-badge @GetBadgeClass(order.Estado)">
                                    @order.Estado
                                </span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="no-history-message" style="padding: 32px; text-align: center; color: #64748B;">
                        No se encontraron pedidos con el filtro seleccionado.
                    </div>
                }
            </div>

            <!-- Register Button -->
            <div class="register-btn-container">
                <button class="btn-register-order" @onclick="OpenRegisterModal">
                    <span class="material-symbols-rounded">add</span>
                    <span>Registrar pedido</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Right Column: Selected Order Details -->
    <div class="order-details-column">
        @if (SelectedOrder != null)
        {
            <div class="dashboard-card details-card">
                <!-- Cyan-Blue Gradient Header -->
                <div class="details-header-banner">
                    <div class="header-banner-text">
                        <h2>Detalles</h2>
                        <span>Pedido #@SelectedOrder.NumeroDisplay</span>
                    </div>
                    <!-- Decorative back card icon -->
                    <span class="material-symbols-rounded decorative-icon">badge</span>
                </div>

                <!-- Properties List -->
                <div class="details-body">
                    <div class="detail-property-row">
                        <span class="prop-label">CLIENTE</span>
                        <span class="prop-val font-bold">@SelectedOrder.Cliente</span>
                    </div>
                    <div class="detail-property-row">
                        <span class="prop-label">DÍA</span>
                        <span class="prop-val">@SelectedOrder.Dia</span>
                    </div>
                    <div class="detail-property-row">
                        <span class="prop-label">HORA RECEPCIÓN</span>
                        <span class="prop-val">@SelectedOrder.HoraRecepcion</span>
                    </div>
                    <div class="detail-property-row">
                        <span class="prop-label">ESTADO ACTUAL</span>
                        <span class="prop-val font-bold" style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                            <span class="order-badge @GetBadgeClass(SelectedOrder.Estado)" style="font-size: 11px; padding: 4px 10px;">@SelectedOrder.Estado</span>
                            @if (SelectedOrder.EsPendienteEntrega)
                            {
                                <span style="font-size: 10px; background: #EDE9FE; color: #6D28D9; border: 1px solid #DDD6FE; padding: 3px 6px; border-radius: 4px; font-weight: 700;">PENDIENTE PARA ENTREGA</span>
                            }
                        </span>
                    </div>
                    <div class="detail-property-row">
                        <span class="prop-label">MÁQUINA</span>
                        <span class="prop-val font-bold">@SelectedOrder.Maquina</span>
                    </div>
                    <div class="detail-property-row">
                        <span class="prop-label">PESO</span>
                        <span class="prop-val">@SelectedOrder.Peso.ToString("0.0") kg</span>
                    </div>
                    <div class="detail-property-row">
                        <span class="prop-label">IMPORTE TOTAL</span>
                        <span class="prop-val val-cost" style="color: #0F172A; font-weight: 700;">@SelectedOrder.Costo.ToString("$#,##0.00")</span>
                    </div>
                    <div class="detail-property-row">
                        <span class="prop-label">MONTO ABONADO</span>
                        <span class="prop-val font-bold" style="color: #059669;">@SelectedOrder.Abonado.ToString("$#,##0.00")</span>
                    </div>
                    <div class="detail-property-row">
                        <span class="prop-label">SALDO PENDIENTE</span>
                        <span class="prop-val font-bold" style="color: @(SelectedOrder.SaldoPendiente > 0 ? "#DC2626" : "#059669");">@SelectedOrder.SaldoPendiente.ToString("$#,##0.00")</span>
                    </div>
                    <div class="detail-property-row">
                        <span class="prop-label">OTROS SERVICIOS</span>
                        <span class="prop-val">@SelectedOrder.OtrosServicios</span>
                    </div>
                    <div class="detail-property-row">
                        <span class="prop-label">EMPLEADO</span>
                        <span class="prop-val">@SelectedOrder.Empleado</span>
                    </div>
                    <div class="detail-property-row">
                        <span class="prop-label">HORA ENTREGA</span>
                        <span class="prop-val">@SelectedOrder.HoraEntrega</span>
                    </div>

                    <!-- Inner action buttons -->
                    <div class="details-actions">
                        <button class="btn-order-status" @onclick="ChangeStatus">
                            Estado del pedido
                        </button>
                        <button class="btn-order-edit" @onclick="EditOrder">
                            <span class="material-symbols-rounded">edit</span>
                            <span>Editar pedido</span>
                        </button>
                        <button class="btn-finalize-order" @onclick="FinalizeOrder">
                            Finalizar pedido
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Interactivo de Filtros de Pedidos -->
@if (ShowFilterModal)
{
    <div class="tipo-pago-backdrop" @onclick="() => ShowFilterModal = false">
        <div class="tipo-pago-modal-card" @onclick:stopPropagation style="max-width: 540px; padding: 40px;">
            <div class="section-header-custom" style="width: 100%; margin-bottom: 24px; justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div class="section-icon-wrapper bg-blue-tint">
                        <span class="material-symbols-rounded">filter_list</span>
                    </div>
                    <h3 class="section-title-custom" style="font-size: 20px;">Filtrar Pedidos</h3>
                </div>
                <button class="btn-clear-filter" @onclick="() => ShowFilterModal = false" style="background: none; border: none; cursor: pointer;">
                    <span class="material-symbols-rounded">close</span>
                </button>
            </div>

            <!-- Search box inside filter modal -->
            <div class="form-input-group" style="width: 100%; margin-bottom: 20px;">
                <label class="form-input-label">Buscar por Cliente o Pedido #</label>
                <div class="form-input-wrapper">
                    <span class="material-symbols-rounded form-input-icon">search</span>
                    <input type="text" class="form-input-field" @bind="SearchText" @bind:event="oninput" placeholder="Nombre o número..." />
                </div>
            </div>

            <!-- Option to hide/show cancelled inside filter modal -->
            <div style="width: 100%; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: #F8FAFC; border-radius: 12px; border: 1px solid #E2E8F0;">
                <div>
                    <strong style="font-size: 13.5px; color: #1E293B; display: block;">Ocultar pedidos cancelados</strong>
                    <span style="font-size: 12px; color: #64748B;">No mostrar órdenes anuladas en la lista</span>
                </div>
                <button type="button" @onclick="ToggleOcultarCancelados" style="background: none; border: none; cursor: pointer; display: flex; align-items: center;">
                    <span class="material-symbols-rounded" style="font-size: 32px; color: @(OcultarCancelados ? "#0891B2" : "#CBD5E1"); transition: color 0.2s;">
                        @(OcultarCancelados ? "toggle_on" : "toggle_off")
                    </span>
                </button>
            </div>

            <!-- Filter by Status options -->
            <div style="width: 100%; margin-bottom: 24px;">
                <label class="form-input-label" style="margin-bottom: 10px; display: block;">Estado del Pedido</label>
                <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                    @foreach (var statusOption in StatusOptions)
                    {
                        <button class="btn-status-filter-chip @(SelectedStatusFilter == statusOption ? "chip-active" : "")" 
                                @onclick="() => SetStatusFilter(statusOption)">
                            @statusOption
                        </button>
                    }
                </div>
            </div>

            <div style="width: 100%; display: flex; gap: 16px; margin-top: 10px;">
                <button class="btn-payment-submit" @onclick="() => ShowFilterModal = false">
                    APLICAR FILTROS
                </button>
                <button class="btn-payment-cancel" @onclick="LimpiarFiltros">
                    RESTAURAR
                </button>
            </div>
        </div>
    </div>
}

@if (MostrarModalPedidoEntregado)
{
    <!-- Recreación exacta de 'evitar finalizar pedido mas de una vez.png' -->
    <div class="tipo-pago-backdrop" @onclick="() => MostrarModalPedidoEntregado = false">
        <div class="tipo-pago-modal-card" @onclick:stopPropagation style="max-width: 500px; padding: 48px 40px;">
            <div class="payment-icon-wrapper" style="margin-bottom: 24px;">
                <div class="payment-icon-bg">
                    <span class="material-symbols-rounded payment-icon">local_laundry_service</span>
                    <span class="online-status-dot"></span>
                </div>
            </div>

            <h2 class="tipo-pago-title" style="margin-bottom: 28px; font-size: 20px; text-transform: uppercase;">
                EL PEDIDO YA ESTA ENTREGADO
            </h2>

            <div style="width: 100%; display: flex; justify-content: center;">
                <button class="btn-pago-efectivo" style="max-width: 240px; padding: 14px 28px;" @onclick="() => MostrarModalPedidoEntregado = false">
                    CONTINUAR
                </button>
            </div>
        </div>
    </div>
}

@if (MostrarModalPedidoNoListo)
{
    <div class="tipo-pago-backdrop" @onclick="() => MostrarModalPedidoNoListo = false">
        <div class="tipo-pago-modal-card" @onclick:stopPropagation style="max-width: 500px; padding: 48px 40px;">
            <div class="payment-icon-wrapper" style="margin-bottom: 24px;">
                <div class="payment-icon-bg">
                    <span class="material-symbols-rounded payment-icon" style="color: #0891B2;">warning</span>
                    <span class="online-status-dot" style="background: #0891B2;"></span>
                </div>
            </div>

            <h2 class="tipo-pago-title" style="margin-bottom: 12px; font-size: 20px; text-transform: uppercase;">
                EL PEDIDO NO ESTÁ LISTO
            </h2>
            <p style="color: #64748B; font-size: 14.5px; margin-bottom: 28px; text-align: center;">
                Sólo se puede finalizar y cobrar un pedido que ya está en estado <strong>'Listo para entregar'</strong>.<br />
                Estado actual: <strong>@SelectedOrder?.Estado</strong>
            </p>

            <div style="width: 100%; display: flex; justify-content: center;">
                <button class="btn-pago-efectivo" style="max-width: 240px; padding: 14px 28px;" @onclick="() => MostrarModalPedidoNoListo = false">
                    ENTENDIDO
                </button>
            </div>
        </div>
    </div>
}

@if (MostrarModalPedidoYaListo)
{
    <div class="tipo-pago-backdrop" @onclick="() => MostrarModalPedidoYaListo = false">
        <div class="tipo-pago-modal-card" @onclick:stopPropagation style="max-width: 500px; padding: 48px 40px;">
            <div class="payment-icon-wrapper" style="margin-bottom: 24px;">
                <div class="payment-icon-bg">
                    <span class="material-symbols-rounded payment-icon" style="color: #3B82F6;">check_circle</span>
                    <span class="online-status-dot" style="background: #3B82F6;"></span>
                </div>
            </div>

            <h2 class="tipo-pago-title" style="margin-bottom: 12px; font-size: 20px; text-transform: uppercase;">
                EL PEDIDO ESTÁ LISTO PARA ENTREGAR
            </h2>
            <p style="color: #64748B; font-size: 15px; margin-bottom: 28px; text-align: center; line-height: 1.5;">
                Este pedido ya está en estado <strong>'Listo para entregar'</strong>.<br />
                Ya ha completado sus procesos de lavado y secado, por lo que <strong>no puede regresar a estados anteriores ni editarse</strong>.
            </p>

            <div style="width: 100%; display: flex; justify-content: center;">
                <button class="btn-pago-efectivo" style="max-width: 240px; padding: 14px 28px;" @onclick="() => MostrarModalPedidoYaListo = false">
                    ENTENDIDO
                </button>
            </div>
        </div>
    </div>
}

@if (MostrarModalAdvertenciaEntregaAnticipada)
{
    <div class="tipo-pago-backdrop" @onclick="() => MostrarModalAdvertenciaEntregaAnticipada = false">
        <div class="tipo-pago-modal-card" @onclick:stopPropagation style="max-width: 440px; padding: 32px; background: #FFFFFF;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px; color: #6D28D9;">
                <span class="material-symbols-rounded" style="font-size: 32px;">event_available</span>
                <h3 style="margin: 0; font-family: 'Outfit', sans-serif; font-size: 18px; font-weight: 800; color: #1E293B;">ENTREGA ANTICIPADA</h3>
            </div>
            <p style="font-size: 14px; color: #475569; line-height: 1.5; margin-bottom: 24px;">
                Este pedido fue programado para entregarse en una fecha posterior (<strong>@FechaEntregaAnticipadaStr</strong>). ¿El cliente vino a recogerlo antes y deseas proceder al cobro y entrega ahora?
            </p>
            <div style="display: flex; gap: 12px; width: 100%;">
                <button class="btn-payment-submit" style="background: #6D28D9; border-color: #6D28D9;" @onclick="ConfirmarIrACobroAnticipado">
                    SÍ, ENTREGAR AHORA
                </button>
                <button class="btn-payment-cancel" @onclick="() => MostrarModalAdvertenciaEntregaAnticipada = false">
                    CANCELAR
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal de Pago y Entrega -->
@if (MostrarModalPagoEntrega)
{
    <div class="tipo-pago-backdrop" @onclick="() => MostrarModalPagoEntrega = false">
        <div class="tipo-pago-modal-card" @onclick:stopPropagation style="max-width: 480px; padding: 36px; text-align: center;">
            <!-- Icon Wrapper -->
            <div class="payment-icon-wrapper" style="margin-bottom: 20px;">
                <div class="payment-icon-bg" style="background: @(ModalSaldoPendiente > 0m ? "#CFFAFE" : "#D1FAE5");">
                    <span class="material-symbols-rounded payment-icon" style="color: @(ModalSaldoPendiente > 0m ? "#0891B2" : "#059669");">
                        @(ModalSaldoPendiente > 0m ? "payments" : "check_circle")
                    </span>
                </div>
            </div>

            <!-- Title & Text -->
            <h3 class="tipo-pago-title" style="margin-bottom: 12px; font-size: 19px; font-weight: 700; color: #1E293B;">
                Confirmación de Entrega
            </h3>

            @if (ModalSaldoPendiente > 0m)
            {
                <p style="font-size: 14.5px; color: #475569; line-height: 1.5; margin-bottom: 24px;">
                    Este pedido tiene un saldo pendiente de <strong style="color: #DC2626; font-size: 16px;">@ModalSaldoPendiente.ToString("$#,##0.00")</strong> pesos.
                    <br />¿Cómo lo está pagando el cliente?
                </p>

                <!-- Payment Method Selector -->
                <div class="form-input-group" style="text-align: left; width: 100%; margin-bottom: 24px;">
                    <label class="form-input-label" style="font-weight: 700; color: #1E293B; margin-bottom: 6px; display: block;">Método de Pago</label>
                    <div class="form-input-wrapper">
                        <span class="material-symbols-rounded form-input-icon">credit_card</span>
                        <select class="form-input-field select-field" style="padding-left: 48px;" @bind="MetodoPagoEntrega">
                            <option value="@Pago.MetodoPago.Efectivo">Efectivo</option>
                            <option value="@Pago.MetodoPago.Tarjeta">Tarjeta</option>
                            <option value="@Pago.MetodoPago.Transferencia">Transferencia</option>
                        </select>
                    </div>
                </div>
            }
            else
            {
                <p style="font-size: 14.5px; color: #475569; line-height: 1.5; margin-bottom: 24px;">
                    Este pedido se encuentra **totalmente liquidado** (Saldo pendiente: $0.00).
                    <br />¿Desea confirmar la entrega física al cliente?
                </p>
            }

            <!-- Action Buttons -->
            <div style="display: flex; gap: 16px; width: 100%; margin-top: 12px;">
                <button class="btn-payment-submit" style="background: #0058BC;" @onclick="ConfirmarPagoEntrega">
                    CONFIRMAR ENTREGA
                </button>
                <button class="btn-payment-cancel" @onclick="() => MostrarModalPagoEntrega = false">
                    CANCELAR
                </button>
            </div>
        </div>
    </div>
}

@code {
    public class OrderItem
    {
        public int Id { get; set; }
        public int NumeroDisplay { get; set; }
        public string Cliente { get; set; }
        public string Dia { get; set; }
        public string HoraRecepcion { get; set; }
        public string Maquina { get; set; }
        public double Peso { get; set; }
        public decimal Costo { get; set; }
        public string OtrosServicios { get; set; }
        public string Empleado { get; set; }
        public string HoraEntrega { get; set; }
        public string Estado { get; set; }
        public decimal Abonado { get; set; } = 0m;
        public decimal SaldoPendiente { get; set; } = 0m;
        public bool EsPendienteEntrega { get; set; }
    }

    private bool MostrarModalPedidoEntregado = false;
    private bool MostrarModalPedidoYaListo = false;
    private bool MostrarModalPedidoNoListo = false;
    private bool MostrarModalAdvertenciaEntregaAnticipada = false;
    private string FechaEntregaAnticipadaStr = "";
    private bool ShowFilterModal = false;
    private string SearchText = "";
    private string SelectedStatusFilter = "TODOS";
    private bool OcultarCancelados = true;

    private readonly string[] StatusOptions = new[] { "TODOS", "EN ESPERA", "EN LAVADO", "EN SECADO", "LISTO", "ENTREGADO", "CANCELADO" };

    private List<OrderItem> Orders = new();
    private OrderItem SelectedOrder;

    private PedidoRepositorio _pedidoRepo = new();
    private ClienteRepositorio _clienteRepo = new();
    private PagoRepositorio _pagoRepo = new();
    private MaquinaRepositorio _maquinaRepo = new();

    private bool MostrarModalPagoEntrega = false;
    private decimal ModalSaldoPendiente = 0m;
    private Pago.MetodoPago MetodoPagoEntrega = Pago.MetodoPago.Efectivo;

    private void ToggleOcultarCancelados()
    {
        OcultarCancelados = !OcultarCancelados;
        if (OcultarCancelados && SelectedStatusFilter == "CANCELADO")
        {
            SelectedStatusFilter = "TODOS";
        }
    }

    private bool CoincideEstado(string estadoPedido, string filtro)
    {
        if (filtro == "TODOS") return true;
        if (filtro == "EN ESPERA") return estadoPedido.Equals("En espera", StringComparison.OrdinalIgnoreCase) || estadoPedido.Equals("En espera de lavado", StringComparison.OrdinalIgnoreCase) || estadoPedido.Equals("En espera de secado", StringComparison.OrdinalIgnoreCase);
        if (filtro == "EN LAVADO") return estadoPedido.Equals("En Lavado", StringComparison.OrdinalIgnoreCase) || estadoPedido.Equals("Lavando", StringComparison.OrdinalIgnoreCase);
        if (filtro == "EN SECADO") return estadoPedido.Equals("En Secado", StringComparison.OrdinalIgnoreCase) || estadoPedido.Equals("Secando", StringComparison.OrdinalIgnoreCase) || estadoPedido.Equals("En espera de secado", StringComparison.OrdinalIgnoreCase);
        if (filtro == "LISTO") return estadoPedido.Equals("Listo", StringComparison.OrdinalIgnoreCase) || estadoPedido.Equals("Listo para entregar", StringComparison.OrdinalIgnoreCase) || estadoPedido.Equals("PENDIENTE PARA ENTREGA", StringComparison.OrdinalIgnoreCase);
        if (filtro == "ENTREGADO") return estadoPedido.Equals("Entregado", StringComparison.OrdinalIgnoreCase) || estadoPedido.Equals("Finalizado", StringComparison.OrdinalIgnoreCase);
        if (filtro == "CANCELADO") return estadoPedido.Equals("Cancelado", StringComparison.OrdinalIgnoreCase);
        return estadoPedido.Equals(filtro, StringComparison.OrdinalIgnoreCase);
    }

    private IEnumerable<OrderItem> FilteredOrders => Orders.Where(o =>
        (!OcultarCancelados || !o.Estado.Equals("CANCELADO", StringComparison.OrdinalIgnoreCase)) &&
        CoincideEstado(o.Estado, SelectedStatusFilter) &&
        (string.IsNullOrWhiteSpace(SearchText) ||
         o.Cliente.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
         o.Id.ToString().Contains(SearchText) ||
         o.NumeroDisplay.ToString().Contains(SearchText))
    );

    protected override void OnInitialized()
    {
        var u = SessionManager.UsuarioActual;
        if (u != null && !u.PuedeGestionarPedidos && !u.PuedeOperarMaquinas)
        {
            NavManager.NavigateTo("/dashboard");
            return;
        }
        CargarPedidos();
        ProcesarParametrosURL();
    }

    protected override void OnParametersSet()
    {
        CargarPedidos();
        ProcesarParametrosURL();
    }

    private void ProcesarParametrosURL()
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        if (!string.IsNullOrEmpty(uri.Query))
        {
            var q = uri.Query.TrimStart('?');
            foreach (var p in q.Split('&'))
            {
                var kv = p.Split('=');
                if (kv.Length == 2 && kv[0].Equals("q", StringComparison.OrdinalIgnoreCase))
                {
                    SearchText = Uri.UnescapeDataString(kv[1]);
                }
            }
        }
    }

    private void CargarPedidos()
    {
        var pedidosDb = _pedidoRepo.ObtenerTodos();
        var clientesDb = _clienteRepo.ListarTodo();
        var pagosDb = _pagoRepo.ObtenerTodos();
        var maquinasDb = _maquinaRepo.ObtenerTodas();
        var serviciosDb = new ServicioRepositorio().ObtenerTodos();
        var detallesRepo = new DetallePedidoRepositorio();

        var servicioLavado = serviciosDb.FirstOrDefault(s => s.IdServicio == 1);
        decimal activePrice = servicioLavado?.Precio ?? 15.00m;

        var cortes = new CorteCajaRepositorio().ObtenerTodos();
        var ultimoCorte = cortes.OrderByDescending(c => c.Fecha).FirstOrDefault();
        bool isAdmin = SessionManager.UsuarioActual?.EsAdmin ?? false;

        var pedidosFiltrados = pedidosDb.Where(p => 
        {
            bool estaEntregadoOCancelado = p.Estado.Equals("Entregado", StringComparison.OrdinalIgnoreCase) || p.Estado.Equals("Cancelado", StringComparison.OrdinalIgnoreCase);

            // 1. Si se registró en días anteriores y está programado para una fecha de entrega posterior a hoy, se muestra SOLO cuando llega el día de su entrega
            if (p.FechaRecepcion.Date < DateTime.Today && p.FechaEntrega.HasValue && p.FechaEntrega.Value.Date > DateTime.Today)
            {
                return false;
            }

            // 2. Si no se ha venido a buscar (está pendiente de entrega) y su fecha de entrega es hoy o anterior
            if (!estaEntregadoOCancelado && (!p.FechaEntrega.HasValue || p.FechaEntrega.Value.Date <= DateTime.Today))
            {
                // Se muestra siempre, incluso después del corte de caja o si es de días pasados
                return true;
            }

            // 3. Ocultar pedidos de días anteriores que ya se entregaron o cancelaron
            bool esDeHoy = p.FechaRecepcion.Date == DateTime.Today || (p.FechaEntrega.HasValue && p.FechaEntrega.Value.Date == DateTime.Today);
            if (!esDeHoy) return false;

            // Para empleados: Ocultar pedidos anteriores al último corte de caja de hoy si ya están completados/cancelados
            if (!isAdmin && ultimoCorte != null && ultimoCorte.Fecha.Date == DateTime.Today)
            {
                if (p.FechaRecepcion <= ultimoCorte.Fecha && estaEntregadoOCancelado)
                {
                    return false;
                }
            }
            return true;
        }).ToList();

        pedidosFiltrados = pedidosFiltrados
            .OrderByDescending(p => !p.Estado.Equals("Entregado", StringComparison.OrdinalIgnoreCase) && !p.Estado.Equals("Cancelado", StringComparison.OrdinalIgnoreCase))
            .ThenByDescending(p => p.IdPedido)
            .ToList();

        Orders = pedidosFiltrados.Select((p, index) => {
            var cliente = clientesDb.FirstOrDefault(c => c.IdCliente == p.IdCliente);
            string nombreCliente = cliente?.Nombre ?? $"Cliente #{p.IdCliente}";

            var pagos = pagosDb.Where(pg => pg.IdPedido == p.IdPedido).ToList();
            decimal abonado = pagos.Sum(x => x.MontoPago);
            decimal saldoPendiente = p.Total - abonado;

            // Cargar detalles para obtener peso real y nombres de servicios reales
            var detalles = detallesRepo.ObtenerPorPedido(p.IdPedido);

            // Asignar máquina dinámicamente según las máquinas reales en la base de datos si no tiene una guardada
            string machineName = !string.IsNullOrEmpty(p.MaquinaAsignada) ? p.MaquinaAsignada : "Sin Asignar";

            // Calcular peso o cantidad total de los servicios del pedido
            var lavadoDetalle = detalles.FirstOrDefault(d => d.IdServicio == 1);
            double peso = lavadoDetalle != null ? lavadoDetalle.Cantidad : detalles.Sum(d => d.Cantidad);

            // Obtener nombres de todos los servicios asociados al pedido
            var nombresServicios = detalles
                .Select(d => serviciosDb.FirstOrDefault(s => s.IdServicio == d.IdServicio)?.Nombre ?? "Servicio")
                .ToList();
            string otrosServicios = nombresServicios.Count > 0 ? string.Join(" + ", nombresServicios) : "Lavado Estándar";

            bool esPendienteEntrega = !p.Estado.Equals("Entregado", StringComparison.OrdinalIgnoreCase) && 
                                      !p.Estado.Equals("Cancelado", StringComparison.OrdinalIgnoreCase) && 
                                      (p.FechaRecepcion.Date < DateTime.Today || (ultimoCorte != null && ultimoCorte.Fecha.Date == DateTime.Today && p.FechaRecepcion <= ultimoCorte.Fecha));

            return new OrderItem {
                Id = p.IdPedido,
                NumeroDisplay = TurnoHelper.ObtenerNumeroDisplay(p.IdPedido),
                Cliente = nombreCliente,
                Dia = p.FechaRecepcion.ToString("dd MMM, yyyy"),
                HoraRecepcion = p.FechaRecepcion.ToString("hh:mm tt"),
                Maquina = machineName,
                Peso = peso,
                Costo = p.Total,
                OtrosServicios = otrosServicios,
                Empleado = SessionManager.UsuarioActual?.Nombre ?? "Atendido en Recepción",
                HoraEntrega = p.FechaEntrega.HasValue ? (p.FechaEntrega.Value.Date == DateTime.Today ? p.FechaEntrega.Value.ToString("hh:mm tt") : p.FechaEntrega.Value.ToString("dd MMM hh:mm tt")) : (p.Estado.ToLower().Contains("entregado") ? p.FechaRecepcion.AddHours(2).ToString("hh:mm tt") : "Pendiente"),
                Estado = p.Estado.ToUpper(),
                Abonado = abonado,
                SaldoPendiente = Math.Max(0m, saldoPendiente),
                EsPendienteEntrega = esPendienteEntrega
            };
        }).ToList();

        var previousId = SelectedOrder?.Id ?? SessionManager.LastSelectedOrderId;
        SelectedOrder = previousId.HasValue ? Orders.FirstOrDefault(o => o.Id == previousId.Value) ?? Orders.FirstOrDefault() : Orders.FirstOrDefault();
        if (SelectedOrder != null)
        {
            SessionManager.LastSelectedOrderId = SelectedOrder.Id;
        }
    }

    private void SelectOrder(OrderItem order)
    {
        SelectedOrder = order;
        SessionManager.LastSelectedOrderId = order.Id;
    }

    private void ToggleFilters()
    {
        ShowFilterModal = !ShowFilterModal;
    }

    private void SetStatusFilter(string status)
    {
        SelectedStatusFilter = status;
        if (status == "CANCELADO")
        {
            OcultarCancelados = false;
        }
    }

    private void LimpiarFiltros()
    {
        SearchText = "";
        SelectedStatusFilter = "TODOS";
        OcultarCancelados = true;
        ShowFilterModal = false;
    }

    private void OpenRegisterModal()
    {
        NavManager.NavigateTo("/pedidos/agregar");
    }

    private void ChangeStatus()
    {
        if (SelectedOrder != null)
        {
            if (SelectedOrder.Estado.Equals("ENTREGADO", StringComparison.OrdinalIgnoreCase))
            {
                MostrarModalPedidoEntregado = true;
                return;
            }
            if (SelectedOrder.Estado.Equals("Listo para entregar", StringComparison.OrdinalIgnoreCase) ||
                SelectedOrder.Estado.Equals("PENDIENTE PARA ENTREGA", StringComparison.OrdinalIgnoreCase))
            {
                MostrarModalPedidoYaListo = true;
                return;
            }
            NavManager.NavigateTo($"/pedidos/estado/{SelectedOrder.Id}");
        }
    }

    private void EditOrder()
    {
        if (SelectedOrder != null)
        {
            if (SelectedOrder.Estado.Equals("ENTREGADO", StringComparison.OrdinalIgnoreCase))
            {
                MostrarModalPedidoEntregado = true;
                return;
            }
            if (SelectedOrder.Estado.Equals("Listo para entregar", StringComparison.OrdinalIgnoreCase) ||
                SelectedOrder.Estado.Equals("PENDIENTE PARA ENTREGA", StringComparison.OrdinalIgnoreCase))
            {
                MostrarModalPedidoYaListo = true;
                return;
            }
            NavManager.NavigateTo($"/pedidos/editar/{SelectedOrder.Id}");
        }
    }

    private void FinalizeOrder()
    {
        if (SelectedOrder != null)
        {
            if (SelectedOrder.Estado.Equals("ENTREGADO", StringComparison.OrdinalIgnoreCase))
            {
                MostrarModalPedidoEntregado = true;
                return;
            }
            if (!SelectedOrder.Estado.Equals("Listo para entregar", StringComparison.OrdinalIgnoreCase) &&
                !SelectedOrder.Estado.Equals("PENDIENTE PARA ENTREGA", StringComparison.OrdinalIgnoreCase))
            {
                MostrarModalPedidoNoListo = true;
                return;
            }

            var pedidoDbCheck = _pedidoRepo.ObtenerPorId(SelectedOrder.Id);
            if (pedidoDbCheck != null && (pedidoDbCheck.Estado.Equals("PENDIENTE PARA ENTREGA", StringComparison.OrdinalIgnoreCase) || (pedidoDbCheck.FechaEntrega.HasValue && pedidoDbCheck.FechaEntrega.Value.Date > DateTime.Today)))
            {
                FechaEntregaAnticipadaStr = pedidoDbCheck.FechaEntrega.HasValue ? pedidoDbCheck.FechaEntrega.Value.ToString("dd MMM yyyy") : "Fecha posterior";
                MostrarModalAdvertenciaEntregaAnticipada = true;
                return;
            }

            NavManager.NavigateTo($"/cobro/{SelectedOrder.Id}");
        }
    }

    private void ConfirmarIrACobroAnticipado()
    {
        MostrarModalAdvertenciaEntregaAnticipada = false;
        if (SelectedOrder != null)
        {
            NavManager.NavigateTo($"/cobro/{SelectedOrder.Id}");
        }
    }

    private void ConfirmarPagoEntrega()
    {
        try
        {
            if (ModalSaldoPendiente > 0m)
            {
                // Registrar el pago restante
                var pago = new Pago
                {
                    IdPedido = SelectedOrder.Id,
                    MontoPago = ModalSaldoPendiente,
                    Metodo = MetodoPagoEntrega,
                    FechaPago = DateTime.Now
                };
                _pagoRepo.Guardar(pago);
            }

            // Cambiar estado a Entregado
            _pedidoRepo.Entregar(SelectedOrder.Id);
            
            ToastService.Show("¡Pedido Entregado!", $"El pedido #{SelectedOrder.NumeroDisplay:D2} ha sido entregado correctamente.", "success");
            
            MostrarModalPagoEntrega = false;
            CargarPedidos();
        }
        catch (Exception ex)
        {
            CustomMessageBox.Show("Error", $"Error al procesar la entrega: {ex.Message}", "error");
        }
    }

    private string GetBadgeClass(string estado)
    {
        return estado.ToUpper() switch
        {
            "EN ESPERA" or "EN ESPERA DE ENTREGA" => "badge-espera",
            "EN ESPERA DE LAVADO" => "badge-espera-lavado",
            "EN LAVADO" or "LAVANDO" => "badge-lavando",
            "EN ESPERA DE SECADO" => "badge-espera-secado",
            "EN SECADO" or "SECANDO" => "badge-secando",
            "LISTO PARA ENTREGAR" or "LISTO" or "TERMINADA" or "PENDIENTE PARA ENTREGA" => "badge-listo",
            "ENTREGADO" or "FINALIZADO" => "badge-entregado",
            "CANCELADO" => "badge-cancelado",
            _ => "badge-espera"
        };
    }

